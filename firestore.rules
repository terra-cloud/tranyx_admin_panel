// ============================================================================
// TRANYX PRODUCTION CLOUD FIRESTORE RULES
// AUTO-GENERATED - DO NOT DIRECTLY EDIT THIS FILE!
// To make changes, edit files in "firestore_rules/" and compile via:
//   dart run tool/build_rules.dart
// ============================================================================

// >>> SOURCE: firestore_rules/00_header.rules
// ============================================================================
// TRANYX CLOUD FIRESTORE SECURITY RULES (MODULAR SOURCE)
// DO NOT DIRECTLY EDIT firestore.rules!
// Edit the modular source files in firestore_rules/ and run:
//   dart run tool/build_rules.dart
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

// >>> SOURCE: firestore_rules/01_common_auth.rules
    // ------------------------------------------------------------------------
    // COMMON AUTHENTICATION & IDENTITY HELPERS
    // ------------------------------------------------------------------------

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is accessing their own document or matches the user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if a user is currently banned or suspended
    function isUserBlocked(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      let docExists = exists(path);
      let userDoc = docExists ? get(path).data : {};
      return docExists && (
        ('banned' in userDoc && userDoc.banned == true) ||
        ('suspendedUntil' in userDoc && userDoc.suspendedUntil is int && userDoc.suspendedUntil > request.time.toMillis())
      );
    }

    // Helper to check if current request user is authenticated and NOT blocked
    function isActiveUser() {
      return isAuthenticated() && !isUserBlocked(request.auth.uid);
    }

// >>> SOURCE: firestore_rules/02_admin_helpers.rules
    // ------------------------------------------------------------------------
    // ADMINISTRATIVE & STAFF AUTHORIZATION HELPERS
    // ------------------------------------------------------------------------

    // Step 1: Zero-read instant verification via Auth Token Claims only. A staff-domain email alone grants
    // nothing (KAN-144): admin/staff access needs a custom claim set server-side.
    function isAdminTokenOrEmail() {
      return isAuthenticated() && (
        (request.auth.token != null && (
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('superadmin' in request.auth.token && request.auth.token.superadmin == true) ||
          ('role' in request.auth.token && (
            request.auth.token.role in [
              'admin', 'staff', 'support', 'agent', 'super_admin', 'superadmin',
              'ADMIN', 'STAFF', 'AGENT', 'SUPER_ADMIN'
            ]
          ))
        ))
      );
    }

    // Step 2: Lazy fallback check on /users/{uid} document
    function isUserAdminInDoc() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let userDoc = exists(userPath) ? get(userPath).data : {};
      return ('isAdmin' in userDoc && userDoc.isAdmin == true) ||
        ('isStaff' in userDoc && userDoc.isStaff == true) ||
        ('isSuperAdmin' in userDoc && userDoc.isSuperAdmin == true) ||
        ('isP2pAgent' in userDoc && userDoc.isP2pAgent == true) ||
        ('role' in userDoc && (
          userDoc.role in [
            'admin', 'staff', 'support', 'agent', 'p2p_agent', 'super_admin', 'superadmin',
            'ADMIN', 'STAFF', 'AGENT', 'SUPPORT', 'SUPER_ADMIN', 'SUPERADMIN'
          ]
        ));
    }

    // Step 3: Lazy check on /p2p_agents/{uid} document
    function isP2pAgentInDoc() {
      // Deactivated agents (isActive:false) lose desk access (KAN-136-B5).
      let path = /databases/$(database)/documents/p2p_agents/$(request.auth.uid);
      return exists(path) && get(path).data.get('isActive', false) == true;
    }

    // Helper to check if the user is an admin, staff member, or registered P2P agent
    function isAdminOrStaff() {
      return isAdminTokenOrEmail() || (isAuthenticated() && (isUserAdminInDoc() || isP2pAgentInDoc()));
    }

// >>> SOURCE: firestore_rules/10_workspace_users_wallets.rules
    // ------------------------------------------------------------------------
    // WORKSPACE: USERS, WALLETS, TRANSACTIONS & FINANCES
    // ------------------------------------------------------------------------

    // Money record owner: the doc's uid or userId field is the caller.
    function ownsRecord(data) {
      return isAuthenticated() && (data.get('uid', '') == request.auth.uid || data.get('userId', '') == request.auth.uid);
    }

    // Owner edits to a withdrawal request after create. The owner only ever cancels (before an agent
    // claims it) or confirms receipt (once the agent sent proof, PENDING_CONFIRMATION -> APPROVED):
    // web firebase_service.dart cancelP2pWithdrawalRequest / confirmP2pWithdrawalCompleted, mobile
    // transit_repository.dart. Every owner write must be one of those two transitions, and each extra
    // field is pinned to it: p2pStatus mirrors the transition, balanceDeducted/refundedAt and
    // rejectionReason only on cancel (never re-arming a refund), adminUid only on confirm and only the
    // owner. verifiedAt (epoch ms, both apps write DateTime.now()) can't predate the request or sit more
    // than 5 minutes past request.time; cancel still sets it because shipped mobile/web clients do.
    // Everything else is admin/agent only.
    function isOwnerWithdrawalUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let next = request.resource.data;
      let from = resource.data.get('status', '');
      let to = next.get('status', '');
      let cancelling = changed.hasAny(['status']) && to == 'CANCELLED' && from in ['WAITING_FOR_AGENT', 'PENDING_REVIEW', 'PENDING'];
      let confirming = changed.hasAny(['status']) && to == 'APPROVED' && from == 'PENDING_CONFIRMATION';
      return ownsRecord(resource.data) && (cancelling || confirming) &&
        changed.hasOnly(['status', 'p2pStatus', 'balanceDeducted', 'refundedAt', 'rejectionReason', 'verifiedAt', 'updatedAt', 'adminUid']) &&
        (!changed.hasAny(['p2pStatus']) || next.p2pStatus == (cancelling ? 'CANCELLED' : 'COMPLETED')) &&
        (!changed.hasAny(['balanceDeducted', 'refundedAt']) || (cancelling && next.get('balanceDeducted', false) == false)) &&
        (!changed.hasAny(['rejectionReason']) || (cancelling && next.rejectionReason is string && next.rejectionReason.size() <= 500)) &&
        (!changed.hasAny(['adminUid']) || (confirming && next.adminUid == request.auth.uid)) &&
        (!changed.hasAny(['verifiedAt']) || (next.verifiedAt is number &&
          next.verifiedAt >= resource.data.get('createdAt', request.time.toMillis() - 300000) &&
          next.verifiedAt <= request.time.toMillis() + 300000));
    }

    // Job-derived global transaction ids (tranyx_app.dart completion flow): payout_nyx_<jobId> is the
    // worker's payout, fees_emp_<jobId> the employer's fees, and either party reads both by id.
    function isTxJobParticipant(txId) {
      let jobPath = /databases/$(database)/documents/jobs/$(txId.replace('^(payout_nyx|fees_emp)_', ''));
      return txId.matches('^(payout_nyx|fees_emp)_.+') && exists(jobPath) &&
        (get(jobPath).data.creatorId == request.auth.uid || get(jobPath).data.get('acceptedApplicantId', null) == request.auth.uid);
    }

    // Structured global transaction ids name the record they belong to, so their uid must be that
    // record's party (app writers: job completion payout_nyx_ = hired worker, fees_emp_ = employer;
    // cancel/delete refund_job_ / refund_stale_job_ = employer; deletePropertyRental refund_prop_ =
    // host; P2P p2p_dep_ / p2p_with_ = owner of the deposit / withdrawal request written just before).
    function isTxIdParty(txId, uid) {
      let jobPath = /databases/$(database)/documents/jobs/$(txId.replace('^(payout_nyx|fees_emp|refund_job|refund_stale_job)_', ''));
      let propPath = /databases/$(database)/documents/properties/$(txId.replace('^refund_prop_', ''));
      let depPath = /databases/$(database)/documents/deposit_requests/$(txId.replace('^p2p_dep_', ''));
      let wrPath = /databases/$(database)/documents/withdrawal_requests/$(txId.replace('^p2p_with_', ''));
      return
        (txId.matches('^payout_nyx_.+') && exists(jobPath) && get(jobPath).data.get('acceptedApplicantId', null) == uid) ||
        (txId.matches('^(fees_emp|refund_job|refund_stale_job)_.+') && exists(jobPath) && get(jobPath).data.creatorId == uid) ||
        (txId.matches('^refund_prop_.+') && exists(propPath) && get(propPath).data.hostId == uid) ||
        (txId.matches('^p2p_dep_.+') && exists(depPath) && get(depPath).data.get('uid', '') == uid) ||
        (txId.matches('^p2p_with_.+') && exists(wrPath) && get(wrPath).data.get('uid', '') == uid);
    }

    // pending_onchain_<uid>_<signature>: the bookkeeping record of an in-flight on-chain payment. The
    // uid in the id must be the caller's, so nobody can squat another account's pending record.
    function isOwnPendingOnchainId(txId, uid) {
      let prefix = 'pending_onchain_' + uid + '_';
      return txId.size() > prefix.size() && txId[0:prefix.size()] == prefix;
    }

    // deposit_sol_ / deposit_usdt_ / sub_sol_ / onchain_ + <signature> are the on-chain credit records and the
    // one-per-signature marker. They are written by the creditOnchainPayment Cloud Function (Admin SDK) only;
    // clients and owners can neither create nor edit them (see transactions rules below).

    // Owner-side premium fields can only move DOWN (expiry downgrade), never up. Granting premium is the
    // job of the creditOnchainPayment / subscribeWithBalance Cloud Functions or staff.
    function ownerPremiumNotRaised() {
      let n = request.resource.data;
      let o = resource.data;
      return (n.get('isPremium', false) == o.get('isPremium', false) || n.get('isPremium', false) == false) &&
        (n.get('premiumUntil', null) == o.get('premiumUntil', null) || n.get('premiumUntil', null) == null ||
          (n.get('premiumUntil', null) is number && o.get('premiumUntil', null) is number &&
            n.get('premiumUntil', null) <= o.get('premiumUntil', null))) &&
        (n.get('accountType', '') == o.get('accountType', '') || n.get('accountType', '') != 'hybrid');
    }

    // KAN-136 stopgap (until KAN-126 Cloud Function ledger): hired worker may create
    // payout_nyx_<jobId> type=payout with amount bound to the job price. fees_emp_ /
    // platform_fees / employer-driven completion stay Function-only (P1/P2).
    function jobCompletionRatesOk(jobId, d) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      let cfgPath = /databases/$(database)/documents/config/app_config;
      let cfg = exists(cfgPath) ? get(cfgPath).data : {};
      let commission = job.get('commissionRate', cfg.get('commissionRate', 0.03));
      let holdback = job.get('holdbackRate', cfg.get('holdbackRate', 0.10));
      return d.get('commissionRate', commission) == commission &&
        d.get('holdbackRate', holdback) == holdback;
    }
    // Payout create: if the worker user doc is credited in the same batch, the bump cannot exceed amount.
    function payoutCreditCapped(d) {
      let uPath = /databases/$(database)/documents/users/$(d.uid);
      return !exists(uPath) ||
        (getAfter(uPath).data.get('tyxBalance', 0) - get(uPath).data.get('tyxBalance', 0) <= d.amount + 0.0001);
    }
    // Amount bound to job price (KAN-136-D2): > 0 and <= pricingValue (holdback may lower the immediate payout).
    function payoutAmountBoundToJob(jobId, d) {
      let price = get(/databases/$(database)/documents/jobs/$(jobId)).data.get('pricingValue', 0);
      return price is number && price > 0 &&
        d.amount is number && d.amount > 0 && d.amount <= price &&
        d.get('baseAmount', price) == price;
    }
    function isJobCompletionTxCreate(txId) {
      let d = request.resource.data;
      let jobId = txId.replace('^payout_nyx_', '');
      let jobPath = /databases/$(database)/documents/jobs/$(jobId);
      return isActiveUser() &&
        txId.matches('^payout_nyx_.+') &&
        exists(jobPath) &&
        d.type == 'payout' &&
        d.uid == request.auth.uid &&
        get(jobPath).data.get('acceptedApplicantId', null) == request.auth.uid &&
        d.keys().hasAll(['uid', 'amount', 'status', 'type', 'createdAt']) &&
        d.status == 'Successful' &&
        payoutAmountBoundToJob(jobId, d) &&
        jobCompletionRatesOk(jobId, d) &&
        payoutCreditCapped(d);
    }

    // Users Collection (Strict segregation of User vs Admin fields)
    match /users/{userId} {
      // KAN-143: no guest reads and no listing/scraping; signed-in users read single profiles by uid
      // (counterparty, host, applicant), staff may query. The web REST client cannot read as a guest and no
      // client queries /users. A public_profiles split (so email/phone/wallet stay private) is follow-up work.
      allow get: if isAuthenticated();
      allow list: if isAdminOrStaff();
      
      // Regular users can create their profile without privileged fields (KAN-144: no role/staff/admin
      // flags and a zero starting balance; signup writes UserProfile.toMap(), which never sets them).
      // Staff (admin claim, or verified staff-domain email via isAdminOrStaff) can bootstrap administrative roles.
      allow create: if (
        (isOwner(userId) &&
          !request.resource.data.keys().hasAny([
            'role', 'banned', 'suspendedUntil', 'admin', 'isAdmin', 'isStaff', 'isSuperAdmin', 'isP2pAgent'
          ]) &&
          request.resource.data.get('tyxBalance', 0) == 0 &&
          request.resource.data.get('reservedBalance', 0) == 0 &&
          request.resource.data.get('isPremium', false) == false &&
          request.resource.data.get('premiumUntil', null) == null &&
          request.resource.data.get('accountType', 'nyxian') != 'hybrid' &&
          !request.resource.data.keys().hasAny([
            'subscriptionPlan', 'subscriptionStartedAt', 'subscriptionPaymentMethod',
            'subscriptionPaymentAmount', 'subscriptionTxId', 'subscriptionStatus'
          ])) ||
        // Staff may bootstrap a profile but never mint a balance: money moves only through the staffOps / money callables.
        (isAdminOrStaff() &&
          request.resource.data.get('tyxBalance', 0) == 0 && request.resource.data.get('reservedBalance', 0) == 0)
      ) &&
      (!('tyxBalance' in request.resource.data) || (request.resource.data.tyxBalance is number && request.resource.data.tyxBalance >= 0));

      allow update: if (
        // 1. Regular User: Can update own profile fields (cannot alter admin role, ban, or suspension status)
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'isStaff', 'isSuperAdmin', 'isP2pAgent', 'banned', 'suspendedUntil', 'rating', 'ratingCount',
          'subscriptionPlan', 'subscriptionStartedAt', 'subscriptionPaymentMethod', 'subscriptionPaymentAmount',
          'subscriptionTxId', 'subscriptionStatus',
          // Money (server-only): tyxBalance / reservedBalance move only through Cloud Functions or staff.
          'tyxBalance', 'reservedBalance'
        ]) && ownerPremiumNotRaised())
        || 
        // 2. Admin / Staff (incl. P2P agents): admin, moderation & verification fields. NOT the balance: staff and
        //    agents change balances only through the staffOps callable (role check, idempotency, audit log).
        (isAdminOrStaff() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tyxBalance', 'reservedBalance']))
        ||
        // 3. Owner's pending subscription request bookkeeping (grants nothing; staff approve it)
        (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pendingSubscription', 'lastSubscriptionRejection', 'updatedAt'
        ]))
        ||
        // 4. Inactive gig reclaim: Allow incrementing worker's abandonedJobs metric
        (isActiveUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abandonedJobs']) &&
          request.resource.data.abandonedJobs is number &&
          (!('abandonedJobs' in resource.data) || request.resource.data.abandonedJobs == resource.data.abandonedJobs + 1)
        )
      ) &&
      (!('tyxBalance' in request.resource.data) || (request.resource.data.tyxBalance is number && request.resource.data.tyxBalance >= 0));

      allow delete: if isAdminOrStaff();
      
      // Legacy user reviews subcollection: read-only for clients. New ratings go to /ratings (KAN-145).
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isAdminOrStaff();
      }

      // User Ledger subcollection
      match /ledger/{ledgerId} {
        allow read, write: if isOwner(userId) || isAdminOrStaff();
      }

      // User Transactions subcollection
      match /transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdminOrStaff();
      }

      // User Points subcollection
      match /points/{docId} {
        allow read, write: if isOwner(userId) || isAdminOrStaff();
      }
    }

    // Wallets Collection (Unified wallet storage & user ledger sub-collections)
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.uid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow write: if (isOwner(walletId) || isAdminOrStaff()) &&
        (!('balance' in request.resource.data) || (request.resource.data.balance is number && request.resource.data.balance >= 0));

      match /transactions/{txId} {
        allow read, write: if isAuthenticated() && (walletId == request.auth.uid || isAdminOrStaff());
        allow delete: if isAdminOrStaff();
      }

      match /ledger/{entryDoc} {
        allow read, write: if isAuthenticated() && (walletId == request.auth.uid || isAdminOrStaff());
        allow delete: if isAdminOrStaff();
      }
    }

    // Wallet Links Collection: wallet address -> uid, one wallet per account. Wallet sign-in was
    // removed (KAN-124), so nothing reads this before sign-in. Get stays open to signed-in users for
    // the "already linked to another account" check; the same mapping is public on
    // users/{uid}.walletPublicKey. Docs hold uid + linkedAt only (no tokens or passwords), and only
    // the linked owner can re-write or delete one.
    match /walletLinks/{walletPublicKey} {
      allow get: if isAuthenticated();
      allow list: if isAdminOrStaff();
      allow create: if isActiveUser() && request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['uid', 'linkedAt']);
      allow update: if isActiveUser() && resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'linkedAt']);
      allow delete: if isAdminOrStaff() || (isActiveUser() && resource.data.uid == request.auth.uid);
    }

    // Global Transactions Collection
    match /transactions/{txId} {
      // get: owner, a participant of the job a payout_nyx_/fees_emp_ id names (only while the doc's
      // uid is still that job's worker/employer, so re-creating a deleted job id grants nothing), or
      // admin/agent. An id that doesn't exist yet is readable by any signed-in user (existence only):
      // the app's idempotency checks (existingTx, txNyxDoc/txEmpDoc, p2p_* lookups) read before writing.
      // Missing payout_nyx_/fees_emp_/refund_prop_ ids only by that job's participants / the host, so
      // denied-vs-missing can't be used to probe someone else's records.
      // list: owner only (getMyTransactions filters uid == caller).
      // onchain_<signature> / deposit_sol_ / deposit_usdt_ / sub_sol_ records are written and checked by the
      // creditOnchainPayment function; clients only read their own.
      allow get: if isAuthenticated() &&
        ((resource == null && (!txId.matches('^(payout_nyx|fees_emp|refund_prop)_.*') ||
            isTxJobParticipant(txId) || isTxIdParty(txId, request.auth.uid))) ||
          (resource != null && ownsRecord(resource.data)) ||
          (isTxJobParticipant(txId) && isTxIdParty(txId, resource.data.get('uid', ''))) || isAdminOrStaff());
      allow list: if isAdminOrStaff() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      // create: a structured id (see isTxIdParty) only by its own party, so nobody can squat a
      // public job / property / request id before the real writer. KAN-146: withdrawal-type ledger
      // rows are written by the requestWithdrawal function only (type withdraw / WITHDRAWAL).
      // KAN-136 stopgap: hired worker may create payout_nyx_<job> type=payout (amount bound to job price).
      allow create: if isAdminOrStaff() || isJobCompletionTxCreate(txId) || (isActiveUser() && request.resource.data.uid == request.auth.uid && !request.resource.data.type.matches('^(payout|rebate|fee_deduction|withdraw|withdrawal|WITHDRAW|WITHDRAWAL)$') &&
        (!txId.matches('^(payout_nyx|fees_emp|refund_job|refund_stale_job|refund_prop|p2p)_.*') || isTxIdParty(txId, request.auth.uid)) &&
        (!txId.matches('^pending_onchain_.*') || isOwnPendingOnchainId(txId, request.auth.uid)) &&
        !txId.matches('^(deposit_sol|deposit_usdt|sub_sol|onchain)_.*'));
      // KAN-136-05: structured job/property/p2p tx ids are create-only for clients (no owner rewrite/replay).
      // On-chain credit records (deposit_<sig> / sub_sol_<sig>) and the shared one-per-signature marker
      // (onchain_<sig>) are Admin SDK / staff only (create and update): the credit happens in the function.
      allow update: if isAdminOrStaff() || (isActiveUser() && resource.data.uid == request.auth.uid &&
        !txId.matches('^(payout_nyx|fees_emp|refund_job|refund_stale_job|refund_prop|p2p|deposit|sub_sol|onchain)_.*') &&
        (!txId.matches('^pending_onchain_.*') ||
          (isOwnPendingOnchainId(txId, request.auth.uid) && request.resource.data.uid == resource.data.uid)));
      allow delete: if isAdminOrStaff();
    }

    // Subscriptions Collection (P2P Hybrid PRO Subscriptions)
    match /subscriptions/{subId} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow create: if isAdminOrStaff() || (isAuthenticated() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdminOrStaff();
      allow delete: if isAdminOrStaff();
    }

    // Deposit Requests Collections (Dual-collection sync: deposit_requests & depositRequests)
    match /deposit_requests/{reqId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    match /depositRequests/{requestId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    match /deposits/{depositId} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    // Withdrawal Requests Collections (Dual-collection sync: withdrawal_requests & withdrawalRequests)
    // KAN-146: requests are created ONLY by the requestWithdrawal Cloud Function (Admin SDK bypasses
    // rules): it debits the balance, computes fee/net/rate/crypto amount and signs the Solana
    // transfer server-side. Clients can no longer create a request, so a client-chosen feeAmount: 0,
    // a forged status or a client-side balance debit for a withdrawal is impossible. Clients still
    // read their own requests and cancel / confirm P2P ones (isOwnerWithdrawalUpdate).
    match /withdrawal_requests/{reqId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAdminOrStaff();
      allow update: if isAdminOrStaff() || isOwnerWithdrawalUpdate();
      allow delete: if isAdminOrStaff();
    }

    match /withdrawalRequests/{requestId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAdminOrStaff(); // KAN-146: server-only, see withdrawal_requests above
      allow update: if isAdminOrStaff() || isOwnerWithdrawalUpdate();
      allow delete: if isAdminOrStaff();
    }

    match /withdrawals/{requestId} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    match /cashout_requests/{requestId} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    // Deposit References & Claimed References Collections
    match /deposit_references/{refKey} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    match /claimed_references/{refKey} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    match /claimed_p2p_references/{refKey} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    match /claimedReferences/{refKey} {
      allow read: if isAdminOrStaff() || ownsRecord(resource.data);
      allow write: if isAdminOrStaff();
    }

    // Points History Collection
    match /points_history/{historyId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow write: if (isActiveUser() && request.resource.data.uid == request.auth.uid) || isAdminOrStaff();
    }

// >>> SOURCE: firestore_rules/20_workspace_rentals.rules
    // ------------------------------------------------------------------------
    // WORKSPACE: VEHICLE RENTALS & ESCROWS
    // ------------------------------------------------------------------------

    // Helper to validate vehicle rental pricing constraints
    function isValidVehiclePricing(data) {
      let priceDaily = ('priceDaily' in data && data.priceDaily is number) ? data.priceDaily : 0.0;
      let price12h = ('price12h' in data && data.price12h is number) ? data.price12h : 0.0;
      let priceWeekly = ('priceWeekly' in data && data.priceWeekly is number) ? data.priceWeekly : 0.0;
      let priceMonthly = ('priceMonthly' in data && data.priceMonthly is number) ? data.priceMonthly : 0.0;
      return priceDaily > 0.0 &&
        (price12h == 0.0 || (price12h >= priceDaily * 0.4 && price12h <= priceDaily)) &&
        (priceWeekly == 0.0 || (priceWeekly >= priceDaily * 3.5 && priceWeekly > priceDaily)) &&
        (priceMonthly == 0.0 || (priceMonthly >= priceDaily * 12.0 && (priceWeekly == 0.0 || priceMonthly > priceWeekly)));
    }

    // Helper to check if current user is the renter, rentee, or host of an escrow
    function isRentalEscrowParty(data) {
      return ('renterId' in data && data.renterId == request.auth.uid) || 
             ('renteeId' in data && data.renteeId == request.auth.uid) || 
             ('hostId' in data && data.hostId == request.auth.uid);
    }

    // Vehicle Rentals Collection (Anti-Exploitation: Host CANNOT alter pricing once booked)
    match /rentals/{rentalId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid && isValidVehiclePricing(request.resource.data);
      
      allow update: if 
        // 1. Host (Vehicle Owner): Can update vehicle/price details & accept bookings when not actively rented
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          request.resource.data.hostId == resource.data.hostId &&
          !(resource.data.status in ['Booked', 'Rented', 'On the way to Rentee', 'Returning', 'Active']) &&
          (request.resource.data.status in ['Available', 'available', 'Not Accepting Bookings', 'Awaiting Signature', 'awaiting signature'] ||
           request.resource.data.status == resource.data.status) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['priceDaily', 'price12h', 'priceWeekly', 'priceMonthly']) ||
           isValidVehiclePricing(request.resource.data)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            // Identity & metadata
            'id', 'hostName', 'hostPhotoUrl', 'acceptingBookings', 'status',
            'isListingFeeWaived', 'createdAt', 'updatedAt',
            // Vehicle specs
            'brand', 'model', 'vehicleModel', 'year', 'type', 'vehicleType',
            'plateNumber', 'transmission', 'fuelType', 'seatingCapacity',
            'mileageLimitPerDay', 'minDriverAge', 'fuelPolicy', 'description', 'features',
            // Pricing & deposit
            'price12h', 'hourlyRate', 'priceDaily', 'PricePerDay', 'pricePerDay',
            'priceWeekly', 'weeklyRate', 'priceMonthly', 'monthlyRate',
            'allowedDurations', 'extensionRatePerHour', 'latePenaltyRatePerHour',
            'vehicleValue', 'securityDeposit', 'depositType', 'depositValue',
            'securityDepositPolicy',
            // Location & compliance
            'location', 'pickupAddress', 'pickupLat', 'pickupLng',
            'ltoCrNumber', 'ltoOrNumber', 'insuranceProvider', 'insurancePolicyNumber',
            'franchisePermit', 'gpsTrackerId',
            // Photos & legal terms
            'photoUrl', 'interiorPhotoUrl', 'frontPhotoUrl', 'backPhotoUrl',
            'extraPhotos', 'contractType', 'contractTerms', 'legalTerms',
            'termsPreset', 'termsTitle', 'termsContent', 'requireRenteeSignature',
            // Driver options
            'offersDriver', 'driverDailyPrice', 'driverNote', 'driverLicenseNumber',
            // Trip & rentee fields
            'renteeId', 'renteeName', 'renteePhotoUrl', 
            'renteePhone', 'renteeRating', 'startEpoch', 'endEpoch', 'expectedReturnEpoch', 
            'deliveryType', 'deliveryAddress', 'deliveryFee', 'currentLocationLat', 
            'currentLocationLng', 'fuelLevel', 'odoMeter', 'pickupPhotos', 
            'dropoffPhotos', 'hostRated', 'renteeRated',
            // Booking acceptance & contract metadata
            'rentalDurationType', 'rentalMultiplier', 'startDate', 'endDate', 
            'totalCost', 'bookingFee', 'renteeSignatureName', 'renteeLicenseNumber', 
            'signedAt', 'trackingLat', 'trackingLng', 'hireWithDriver', 'rentalType', 
            'currentRequestId', 'allowChat', 'verificationSelfieUrl', 
            'verificationGovtIdUrl', 'verificationStatus', 'hostIsVerified', 
            'hostVerificationStatus', 'hostVerificationTier', 'renteeIsVerified', 
            'renteeVerificationStatus', 'renteeVerificationTier',
            // Listing deletion & archival
            'isDeleted', 'deletedAt'
          ])
        ) ||
        // 1b. Host: When awaiting signature, can revoke approval (back to Available) or activate lease
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          (resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeId', 'renteeName', 'renteePhotoUrl', 'startDate', 
            'endDate', 'totalCost', 'bookingFee', 'currentRequestId', 
            'renteeSignatureName', 'signedAt', 'allowChat'
          ])
        ) ||
        // 1c. Host: When vehicle is active/booked, can submit rating, accept extensions, update tracking, or complete/reset rental
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          resource.data.status != 'Available' && resource.data.status != 'available' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hostRated', 'endDate', 'totalCost', 'status', 'trackingLat', 'trackingLng',
            'renteeId', 'renteeName', 'renteePhotoUrl', 'rentalDurationType', 'rentalMultiplier',
            'startDate', 'bookingFee', 'renteeSignatureName', 'renteeLicenseNumber', 'signedAt',
            'currentRequestId', 'allowChat'
          ])
        ) ||
        // 2a. Assigned Rentee: Can sign contract when status is Awaiting Signature
        (isActiveUser() && 
          ((resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
           (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
            ('renterId' in resource.data && resource.data.renterId == request.auth.uid) ||
            ('currentRequestId' in resource.data))) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeSignatureName', 'signedAt', 'signatureHash', 
            'currentRequestId', 'renteeLicenseNumber'
          ])
        ) ||
        // 2b. Assigned Rentee: When active, can update trip status, return info, location, extensions & rating
        (isActiveUser() && 
          (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
           ('renterId' in resource.data && resource.data.renterId == request.auth.uid)) && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'currentLocationLat', 'currentLocationLng', 'fuelLevel', 
            'odoMeter', 'dropoffPhotos', 'renteeRated', 'endDate', 'totalCost'
          ])
        ) ||
        // 3. Admin / Staff
        isAdminOrStaff();

      allow delete: if (isActiveUser() && resource.data.hostId == request.auth.uid && (resource.data.status == 'Available' || resource.data.status == 'available')) || isAdminOrStaff();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }

      match /qna/{qnaId} {
        allow read: if true;
        allow write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Rental Requests Collection
    // Booking request guard (rental_requests / property_requests). The bookingRequest callable creates these docs
    // (Admin SDK) and bookingAction settles the money from the escrow doc, but it also reads this doc's `status`.
    // A party who could write any status could therefore park a funded booking in a closed state and block the refund
    // or payout. Clients may only: be a party; leave the identity / money fields alone; do the legitimate
    // transitions (host Pending->Approved, renter ->Booked once approved); and write a closing status
    // (Rejected / Cancelled / Completed / Refunded) only while NO escrow is held (legacy no-escrow requests).
    // Writes that leave `status` unchanged (e.g. echoing what the callable just set) stay allowed.
    function requestPartyUpdateOk(escrowPath) {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let uid = request.auth.uid;
      let isHost = before.get('hostId', '') == uid;
      let isRentee = before.get('renteeId', '') == uid || before.get('renterId', '') == uid;
      let closing = ['Rejected', 'Cancelled', 'Completed', 'Refunded'];
      let escrowHeld = exists(escrowPath) && get(escrowPath).data.get('status', '') == 'Held';
      return (isHost || isRentee)
        && !changed.hasAny(['renteeId', 'renterId', 'hostId', 'bookingFee', 'discountAmount', 'promoCode',
                            'securityDepositAmount', 'baseRentAmount', 'hostCommissionRate', 'customerPlatformFeeAmount',
                            'customerPlatformFeeRate', 'totalCustomerPaid', 'escrowStatus', 'refundAmount', 'createdAt'])
        && (!changed.hasAny(['status']) || (
          (after.status == 'Approved' && isHost && before.status == 'Pending') ||
          (after.status == 'Booked' && isRentee && before.status in ['Approved', 'Awaiting Signature']) ||
          (after.status in closing && !escrowHeld && !(before.status in closing)) ||
          (!(after.status in closing) && !(after.status in ['Pending', 'Approved', 'Booked']) && !(before.status in closing))
        ));
    }

    match /rental_requests/{requestId} {
      allow read: if isAuthenticated();
      // Created / deleted only by the bookingRequest callable (Admin SDK) or staff.
      allow create, delete: if isAdminOrStaff();
      allow update: if (isActiveUser() && requestPartyUpdateOk(/databases/$(database)/documents/rental_escrows/$(requestId))) || isAdminOrStaff();
    }

    // Rental Extensions Collection
    match /rental_extensions/{extId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Rental History Collection
    match /rental_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Rental Escrows Collection (Dual-field support for renteeId & renterId)
    match /rental_escrows/{rentalId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      // Phase 4: escrow docs hold real money. Only the bookingRequest / bookingAction / rentalExtension
      // callables (Admin SDK) write them; clients and parties can only read.
      allow create, update, delete: if isAdminOrStaff();
    }

    // Rental Extension Escrows Collection
    match /rental_extension_escrows/{extensionId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      // Phase 4: escrow docs hold real money. Only the bookingRequest / bookingAction / rentalExtension
      // callables (Admin SDK) write them; clients and parties can only read.
      allow create, update, delete: if isAdminOrStaff();
    }

    // Rental Contracts Collection (Permanent immutable contract snapshots)
    match /rental_contracts/{contractId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        isRentalEscrowParty(request.resource.data) || 
        isAdminOrStaff()
      );
      allow update, delete: if isAdminOrStaff();
    }

// >>> SOURCE: firestore_rules/30_workspace_jobs.rules
    // ------------------------------------------------------------------------
    // WORKSPACE: JOBS, APPLICATIONS, ESCROWS & REPUTATION
    // ------------------------------------------------------------------------

    // Non-admin job updates, one branch per action (see allow update in /jobs).
    function isJobParticipantUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      let isCreator = before.creatorId == request.auth.uid;
      let isWorker = before.get('acceptedApplicantId', null) == request.auth.uid;
      let openOrReviewing = before.status in ['Open', 'open', 'Reviewing', 'reviewing'];
      let unassigned = before.get('acceptedApplicantId', null) == null || before.acceptedApplicantId == '';
      return
        // 1. Creator (Employer): Can update listing details ONLY when job status is Open or Reviewing
        (isCreator && openOrReviewing && unassigned && changed.hasOnly([
          'id', 'title', 'description', 'category', 'categoryGroup', 'employmentType',
          'dateRequirement', 'jobDate', 'timePreference', 'pricingType', 'pricingValue',
          'locationType', 'address', 'landmark', 'status', 'applicantCount',
          'recentApplicantPhotos', 'applicantUids', 'pickupAddress', 'pickupLat',
          'pickupLng', 'destinationAddress', 'destinationLat', 'destinationLng',
          'hasTracker', 'hasInspectionHoldback', 'imageUrls', 'acceptedApplicantId',
          'acceptedApplicantName', 'receiptUrl', 'employerRated',
          'nyxianRated', 'promoCode', 'discountAmount', 'creatorPhotoUrl',
          'creatorName', 'creatorType', 'createdAt', 'updatedAt',
          'acknowledgmentDeadline', 'acknowledgmentSlaMinutes', 'acknowledgmentCategory',
          'acknowledgmentStatus', 'acknowledgedAt', 'hiredAt', 'acknowledgmentReminderSent'
        ])) ||
        // 1b. Creator (Employer): Resetting, re-opening or cancelling an unacknowledged or expired job
        (isCreator &&
          before.status in ['Awaiting Acknowledgment', 'awaiting acknowledgment', 'Acknowledgment Expired', 'acknowledgment expired'] &&
          changed.hasOnly([
            'status', 'acceptedApplicantId', 'acceptedApplicantName', 'updatedAt',
            'acknowledgmentDeadline', 'acknowledgmentSlaMinutes', 'acknowledgmentCategory',
            'acknowledgmentStatus', 'acknowledgedAt', 'hiredAt', 'acknowledgmentReminderSent'
          ])) ||
        // 1c. Creator (Employer): When job is completed/active, can ONLY submit employer rating
        (isCreator && before.status != 'Open' && before.status != 'open' && changed.hasOnly(['employerRated'])) ||
        // 1d. Creator (Employer): Reclaiming an inactive/stalled job and marking it Abandoned
        (isCreator && after.status in ['Abandoned', 'abandoned'] &&
          changed.hasOnly(['status', 'abandonedAt', 'abandonReason', 'updatedAt'])) ||
        // 1e. Active Participants: Raising a dispute for admin arbitration
        ((isCreator || isWorker) && after.status in ['Disputed', 'disputed'] &&
          changed.hasOnly(['status', 'disputeId', 'disputedAt', 'disputedBy', 'updatedAt'])) ||
        // Active participants can touch lastActivityAt
        ((isCreator || isWorker) && changed.hasOnly(['lastActivityAt'])) ||
        // 2. Assigned Nyxian (Freelancer): Can update work progress, status & completion fields
        (isWorker &&
          (!changed.hasAny(['status']) || after.status == before.status ||
            (after.status in ['In Progress', 'in progress', 'arrived_pickup', 'paid_cashier',
                             'in_transit', 'arrived_dropoff', 'Done', 'done', 'Completed', 'completed'] &&
             before.status in ['Awaiting Acknowledgment', 'awaiting acknowledgment',
                            'In Progress', 'in progress', 'arrived_pickup', 'paid_cashier',
                            'in_transit', 'arrived_dropoff', 'Done', 'done'])) &&
          changed.hasOnly(['status', 'receiptUrl', 'nyxianRated',
                           'acknowledgedAt', 'acknowledgmentStatus', 'updatedAt'])) ||
        // 2b. SLA Expiration or Reminder update by active participants
        ((isCreator || isWorker) && before.status in ['Awaiting Acknowledgment', 'awaiting acknowledgment'] &&
          changed.hasOnly(['status', 'acknowledgmentStatus', 'acknowledgmentReminderSent', 'updatedAt'])) ||
        // 3. Any Active Applicant: Can apply to or withdraw from an Open/Reviewing job
        (openOrReviewing && unassigned &&
          changed.hasOnly(['applicantCount', 'applicantUids', 'recentApplicantPhotos']));
    }

    // Server-owned completion codes (jobAction generateCode / complete, Admin SDK only). Never readable or writable by a
    // client, not even the employer: the code reaches the non-verifier through the callable response.
    match /job_secrets/{jobId} {
      allow read, write: if false;
    }

    // Jobs Collection (Anti-Exploitation: Employer CANNOT alter terms once hired)
    match /jobs/{jobId} {
      allow read: if true; // Publicly browse jobs
      allow create: if isActiveUser() && request.resource.data.creatorId == request.auth.uid;
      
      // Update: same per-action conditions as before, but evaluated in ONE function so the shared
      // values (diff, caller role, status) are computed once. Denied writes used to run every allow
      // separately and hit the 1,000-expression limit; behaviour is unchanged.
      allow update: if isJobParticipantUpdate() && isActiveUser();
      // 4. Admin / Staff
      allow update: if isAdminOrStaff();

      // A creator can't delete a job that already has payout/fee records: the tx docs would outlive
      // it and the public job id could be re-created by someone else (deleteJob / tranyx_app.dart
      // only delete Open/Cancelled jobs, which never have them).
      allow delete: if (isActiveUser() && resource.data.creatorId == request.auth.uid && (
        resource.data.status == 'Open' || 
        resource.data.status == 'open' || 
        resource.data.status == 'Cancelled' || 
        resource.data.status == 'cancelled'
      ) && !exists(/databases/$(database)/documents/transactions/$('payout_nyx_' + jobId)) &&
        !exists(/databases/$(database)/documents/transactions/$('fees_emp_' + jobId))) || isAdminOrStaff();

      // Subcollection: Applications
      match /applications/{applicantId} {
        allow read: if isAuthenticated();
        allow create, update: if (
          (isActiveUser() && (
            request.auth.uid == applicantId ||
            (resource != null && (resource.data.applicantId == request.auth.uid || resource.data.applicantUid == request.auth.uid)) ||
            get(/databases/$(database)/documents/jobs/$(jobId)).data.creatorId == request.auth.uid
          )) ||
          isAdminOrStaff()
        ) && (
          // Standard rate bids
          request.resource.data.isCounterOffer != true ||
          // Counter offers: strictly positive (> 0) and restricted to 80% - 150% of the job's pricingValue
          (
            request.resource.data.proposalRate is number &&
            request.resource.data.proposalRate > 0 &&
            get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue is number &&
            get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue > 0 &&
            request.resource.data.proposalRate >= (get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue * 0.8) - 0.01 &&
            request.resource.data.proposalRate <= (get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue * 1.5) + 0.01
          )
        );
        allow delete: if (isActiveUser() && (
          request.auth.uid == applicantId ||
          (resource != null && (resource.data.applicantId == request.auth.uid || resource.data.applicantUid == request.auth.uid))
        )) || isAdminOrStaff();
      }

      // Subcollection: Messages (old job chat room): the job's employer, hired worker or applicants.
      // isChatParty on the caller's own scoped id job_<jobId>_<uid> is exactly that check.
      match /messages/{messageId} {
        allow read: if (isAuthenticated() && isChatParty('job_' + jobId + '_' + request.auth.uid, request.auth.uid)) || isAdminOrStaff();
        allow write: if (isActiveUser() && isChatParty('job_' + jobId + '_' + request.auth.uid, request.auth.uid)) || isAdminOrStaff();
      }

      // Subcollection: Questions (Public Q&A)
      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }

      // Subcollection: QnA (Public Q&A alternative path)
      match /qna/{qnaId} {
        allow read: if true;
        allow write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Job Escrow Collection
    match /escrow/{jobId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.creatorId == request.auth.uid || 
        resource.data.employerId == request.auth.uid || 
        resource.data.workerId == request.auth.uid || 
        isAdminOrStaff()
      );
      // Phase 4: gig escrow holds real money; only the jobAction callable (Admin SDK) and staff write it.
      allow create, update, delete: if isAdminOrStaff();
    }

    // Escrow Holdbacks Collection
    match /escrow_holdbacks/{holdbackId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.employerId == request.auth.uid || resource.data.get('nyxianId', null) == request.auth.uid || isAdminOrStaff());
      // Phase 4: holdbacks are created at completion and released by jobAction (Admin SDK); staff only from clients.
      allow create, update, delete: if isAdminOrStaff();
    }

    // Job Cancellation Audit Logs Collection
    match /job_cancellation_logs/{logId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.cancelledBy == request.auth.uid ||
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        request.resource.data.cancelledBy == request.auth.uid ||
        isAdminOrStaff()
      );
      allow update, delete: if isAdminOrStaff();
    }

    // ------------------------------------------------------------------------
    // RATINGS & REPORTS (KAN-145): create-only docs, one per (job, rater). Clients never touch the other
    // user's users/{id} doc. Averages/aggregation belong to the server-side ledger work (KAN-126).
    // ------------------------------------------------------------------------

    // The two parties of a job are its creator (employer) and its accepted applicant (worker).
    function isJobPartyPair(jobId, a, b) {
      let j = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      let w = j.get('acceptedApplicantId', null);
      return w != null && a != b &&
        ((j.creatorId == a && w == b) || (j.creatorId == b && w == a));
    }

    // Rating: only for a Completed job; rater and ratee are its two parties; 1..5 int; optional comment.
    function isValidRatingCreate(ratingId) {
      let d = request.resource.data;
      return isActiveUser() &&
        d.keys().hasOnly(['jobId', 'raterId', 'rateeId', 'rating', 'comment', 'createdAt']) &&
        d.keys().hasAll(['jobId', 'raterId', 'rateeId', 'rating', 'createdAt']) &&
        d.jobId is string && d.raterId == request.auth.uid && d.rateeId is string &&
        ratingId == d.jobId + '_' + d.raterId &&
        d.rating is int && d.rating >= 1 && d.rating <= 5 &&
        (!('comment' in d) || (d.comment is string && d.comment.size() <= 500)) &&
        d.createdAt == request.time &&
        get(/databases/$(database)/documents/jobs/$(d.jobId)).data.status in ['Completed', 'completed'] &&
        isJobPartyPair(d.jobId, d.raterId, d.rateeId);
    }

    // Report: any job that has an assigned worker (in progress, completed, cancelled/abandoned/disputed
    // after assignment), never an Open/Reviewing job.
    function isValidReportCreate(reportId) {
      let d = request.resource.data;
      return isActiveUser() &&
        d.keys().hasOnly(['jobId', 'reporterId', 'reportedId', 'reason', 'details', 'createdAt']) &&
        d.keys().hasAll(['jobId', 'reporterId', 'reportedId', 'reason', 'createdAt']) &&
        d.jobId is string && d.reporterId == request.auth.uid && d.reportedId is string &&
        reportId == d.jobId + '_' + d.reporterId &&
        d.reason is string && d.reason.size() >= 1 && d.reason.size() <= 100 &&
        (!('details' in d) || (d.details is string && d.details.size() <= 1000)) &&
        d.createdAt == request.time &&
        !(get(/databases/$(database)/documents/jobs/$(d.jobId)).data.status in ['Open', 'open', 'Reviewing', 'reviewing']) &&
        isJobPartyPair(d.jobId, d.reporterId, d.reportedId);
    }

    match /ratings/{ratingId} {
      allow read: if isAuthenticated() && (resource.data.raterId == request.auth.uid || resource.data.rateeId == request.auth.uid || isAdminOrStaff());
      allow create: if isValidRatingCreate(ratingId);
    }

    match /reports/{reportId} {
      allow read: if isAuthenticated() && (resource.data.reporterId == request.auth.uid || resource.data.reportedId == request.auth.uid || isAdminOrStaff());
      allow create: if isValidReportCreate(reportId);
    }

// >>> SOURCE: firestore_rules/40_workspace_properties.rules
    // ------------------------------------------------------------------------
    // WORKSPACE: PROPERTY RENTALS, LEASES & CONTRACT DOCUMENTS
    // ------------------------------------------------------------------------

    // Properties Collection (Anti-Exploitation: Host CANNOT alter pricing/rules once booked)
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid;
      
      allow update: if 
        // 1. Host (Property Owner): Can update property details & accept bookings when not actively rented
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          request.resource.data.hostId == resource.data.hostId &&
          (resource.data.status == 'Available' || resource.data.status == 'available' || resource.data.status == 'Not Accepting Bookings') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            // Identity & metadata
            'id', 'hostName', 'hostPhotoUrl', 'title', 'type', 'category',
            'propertyType', 'description', 'status', 'acceptingBookings',
            'isListingFeeWaived', 'createdAt', 'updatedAt',
            // Pricing & deposit
            'pricePerMonth', 'priceMonthly', 'priceWeekly', 'priceDaily',
            'nightlyPrice', 'weeklyDiscount', 'monthlyDiscount', 'cleaningFee',
            'allowedDurations', 'depositMonths', 'depositAmount',
            'securityDepositAmount', 'advanceAmount', 'depositType',
            'depositValue', 'securityDepositPolicy',
            // Location & specs
            'address', 'location', 'landmark', 'lat', 'lng', 'latitude', 'longitude',
            'bedrooms', 'bathrooms', 'maxGuests', 'sqft', 'furnishing',
            'amenities', 'houseRules',
            // Photos & legal terms
            'photoUrl', 'photoUrls', 'images', 'contractType', 'contractTerms',
            'legalTerms', 'termsPreset', 'termsTitle', 'termsContent',
            'requireRenteeSignature',
            // Lease & rentee fields
            'renteeId', 'renteeName', 'renteePhotoUrl', 'checkInDate', 
            'checkOutDate', 'hostRated', 'renteeRated',
            // Booking acceptance & lease metadata
            'rentalDurationType', 'rentalMultiplier', 'startDate', 'endDate', 
            'totalCost', 'baseRentAmount', 'bookingFee', 
            'customerPlatformFeeRate', 'hostCommissionRate', 'renteeSignatureName', 
            'signedAt', 'currentRequestId', 'allowChat', 'licenseNumber', 
            'verificationSelfieUrl', 'verificationGovtIdUrl', 'verificationStatus', 
            'hostIsVerified', 'hostVerificationStatus', 'hostVerificationTier', 
            'renteeIsVerified', 'renteeVerificationStatus', 'renteeVerificationTier',
            // Listing deletion & archival
            'isDeleted', 'deletedAt'
          ])
        ) ||
        // 1b. Host: When awaiting signature, can revoke approval (back to Available) or activate lease
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          (resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeId', 'renteeName', 'renteePhotoUrl', 'rentalDurationType', 
            'rentalMultiplier', 'startDate', 'endDate', 'checkInDate', 'checkOutDate', 
            'totalCost', 'baseRentAmount', 'securityDepositAmount', 'bookingFee', 
            'currentRequestId', 'renteeSignatureName', 'signedAt', 'licenseNumber', 'allowChat'
          ])
        ) ||
        // 1c. Host: When property is active/booked, can submit rating, accept extensions, or complete/reset rental
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          resource.data.status != 'Available' && resource.data.status != 'available' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hostRated', 'endDate', 'checkOutDate', 'totalCost', 'status',
            'renteeId', 'renteeName', 'renteePhotoUrl', 'rentalDurationType', 'rentalMultiplier',
            'startDate', 'baseRentAmount', 'securityDepositAmount', 'bookingFee',
            'renteeSignatureName', 'signedAt', 'currentRequestId', 'licenseNumber', 'allowChat'
          ])
        ) ||
        // 2a. Assigned Rentee: Can sign contract when status is Awaiting Signature
        (isActiveUser() && 
          ((resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
           (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
            ('renterId' in resource.data && resource.data.renterId == request.auth.uid) ||
            ('currentRequestId' in resource.data))) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeSignatureName', 'signedAt', 'signatureHash', 
            'currentRequestId', 'licenseNumber'
          ])
        ) ||
        // 2b. Assigned Rentee: When active, can update booking status, extensions & guest rating
        (isActiveUser() && 
          (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
           ('renterId' in resource.data && resource.data.renterId == request.auth.uid)) && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeRated', 'endDate', 'checkOutDate', 'totalCost'
          ])
        ) ||
        // 3. Admin / Staff
        isAdminOrStaff();

      allow delete: if (isActiveUser() && resource.data.hostId == request.auth.uid && (resource.data.status == 'Available' || resource.data.status == 'available')) || isAdminOrStaff();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }

      match /qna/{qnaId} {
        allow read: if true;
        allow write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Property Requests Collection
    match /property_requests/{requestId} {
      allow read: if isAuthenticated();
      // Created / deleted only by the bookingRequest callable (Admin SDK) or staff. See requestPartyUpdateOk (20_workspace_rentals).
      allow create, delete: if isAdminOrStaff();
      allow update: if (isActiveUser() && requestPartyUpdateOk(/databases/$(database)/documents/property_escrows/$(requestId))) || isAdminOrStaff();
    }

    // Property Escrows Collection (Dual-field support for renteeId & renterId)
    match /property_escrows/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      // Phase 4: escrow docs hold real money. Only the bookingRequest / bookingAction / rentalExtension
      // callables (Admin SDK) write them; clients and parties can only read.
      allow create, update, delete: if isAdminOrStaff();
    }

    // Property History Collection
    match /property_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Contract Documents Collection (Custom Contract PDFs & Metadata)
    match /contract_documents/{docId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid;
      allow update: if isActiveUser() && (resource.data.hostId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

// >>> SOURCE: firestore_rules/50_workspace_comms.rules
    // ------------------------------------------------------------------------
    // WORKSPACE: CHATS, COMMUNICATIONS, SUPPORT TICKETS & NOTIFICATIONS
    // ------------------------------------------------------------------------

    // Chat ids name the record they belong to (index.html sendChatMessage, tranyx_app.dart openChat,
    // active_trip_tracker_sheet.dart:263, job_repository.dart:462):
    //   job_<jobId>_<uid>                      employer <-> that applicant or hired worker
    //   rental_<rentalId>_<uid>, property_<propertyId>_<uid>   listing host <-> that renter
    //   <jobId>                                legacy room: employer <-> hired worker
    // Membership comes from that record, not chats.userIds, because web posts the first message before
    // it writes the chat doc (index.html:2046 runs before the async :1998).
    function chatInfo(chatId) {
      let p = chatId.split('_');
      let kind = (p.size() == 3 && p[0] in ['job', 'rental', 'property']) ? p[0] : 'legacy';
      let coll = kind == 'rental' ? 'rentals' : (kind == 'property' ? 'properties' : 'jobs');
      let path = /databases/$(database)/documents/$(coll)/$(kind == 'legacy' ? chatId : p[1]);
      let rec = exists(path) ? get(path).data : {};
      let renter = kind == 'legacy' ? rec.get('acceptedApplicantId', null) : p[2];
      return {
        'kind': kind,
        'rec': rec,
        'renter': renter,
        'owner': kind in ['rental', 'property'] ? rec.get('hostId', null) : rec.get('creatorId', null),
        'renterOk': kind == 'legacy' ||
          (kind == 'job' && (renter == rec.get('acceptedApplicantId', null) || renter in rec.get('applicantUids', []))) ||
          (kind != 'job' && renter == rec.get('renteeId', null))
      };
    }

    // A pending/approved requester is not the listing's renteeId yet and request ids (req_<micros>) can't be
    // derived from the chat id, so for rental/property chats the renter is also a party once the HOST has
    // written them into userIds (manage_property_modal.dart:905, manage_vehicle_modal.dart:1193).
    // Ceiling: a requester can't open that chat until the host has messaged first. Upgrade: put the
    // request id in the chat id, or let a Cloud Function create the chat on request approval.
    function isChatParty(chatId, uid) {
      let c = chatInfo(chatId);
      let chatPath = /databases/$(database)/documents/chats/$(chatId);
      return (c.owner != null && uid == c.owner) ||
        (c.renter != null && uid == c.renter && (c.renterOk ||
          (c.kind in ['rental', 'property'] && exists(chatPath) && uid in get(chatPath).data.get('userIds', []))));
    }

    function isValidChatDoc(chatId) {
      let d = request.resource.data;
      // added + changed: allow-listed. removedKeys: never drop userIds; never strip status/resolvedAt (KAN-139).
      // Web chat touches use masked setDocument (firebase_service.dart ack/expire/reminder/reset); other removals (e.g. legacy createdAt) stay ok.
      let df = d.diff(resource == null ? {} : resource.data);
      let changed = df.addedKeys().union(df.changedKeys());
      let removed = df.removedKeys();
      let c = chatInfo(chatId);
      return changed.hasOnly(['userIds', 'jobId', 'applicantId', 'rentalId', 'propertyId', 'type', 'id', 'lastMessage', 'updatedAt']) &&
        !removed.hasAny(['userIds', 'status', 'resolvedAt']) &&
        (!('userIds' in changed) || !('userIds' in d) ||
          (d.userIds is list && d.userIds.size() == 2 && d.userIds.toSet() == [c.renter, c.owner].toSet()));
    }

    // senderId is the caller, or 'system' with a known type. Ceiling: clients still write system
    // messages (job_repository.dart:463, firebase_service.dart:1778/1981/2643/2705/2781/2854,
    // tranyx_app.dart:4933) until a Cloud Function owns them (CHAT-P1).
    function isValidChatMessage(chatId) {
      let d = request.resource.data;
      let c = chatInfo(chatId);
      return d.keys().hasOnly(['senderId', 'senderName', 'text', 'content', 'photoUrl', 'type', 'createdAt',
                               'category', 'deadline', 'slaMinutes', 'disputeId', 'openedBy']) &&
        (d.senderId == request.auth.uid ? d.get('type', 'text') == 'text' :
          (d.senderId == 'system' && d.get('type', '') in ['acknowledgment_request', 'acknowledgment_confirmed',
            'acknowledgment_expired', 'acknowledgment_reminder', 'job_reopened', 'job_abandoned', 'dispute_opened'])) &&
        // epoch ms from up to 24 h ago (offline queue) to 5 min ahead (clock skew).
        (d.createdAt == request.time || (d.createdAt is int && d.createdAt >= request.time.toMillis() - 86400000 &&
          d.createdAt <= request.time.toMillis() + 300000)) &&
        d.get('text', '') is string && d.get('text', '').size() <= 2000 &&
        d.get('content', '') is string && d.get('content', '').size() <= 2000 &&
        // Host switched chat off on the listing (manage_listing_sheet.dart:1504); the host can still post.
        (c.kind in ['job', 'legacy'] || request.auth.uid == c.owner || c.rec.get('allowChat', true) != false);
    }

    // Notifications Collection. Any signed-in user may notify another (chat, hire, P2P flows write the
    // recipient's doc); only the recipient or admin reads, deletes or marks it.
    match /notifications/{notifId} {
      allow read, delete: if (isAuthenticated() && resource.data.get('uid', null) == request.auth.uid) || isAdminOrStaff();
      // 'id': web re-saves the doc it read with its id field (tranyx_app.dart:1211).
      allow update: if (isAuthenticated() && resource.data.get('uid', null) == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'id'])) || isAdminOrStaff();
      allow create: if isActiveUser() || isAuthenticated() || isAdminOrStaff();
    }

    // Direct Chats Collection
    match /chats/{chatId} {
      allow get: if (isAuthenticated() && isChatParty(chatId, request.auth.uid)) || isAdminOrStaff();
      allow list, delete: if isAdminOrStaff();
      allow create, update: if (isActiveUser() && isChatParty(chatId, request.auth.uid) && isValidChatDoc(chatId)) || isAdminOrStaff();

      match /messages/{messageId} {
        allow read: if (isAuthenticated() && isChatParty(chatId, request.auth.uid)) || isAdminOrStaff();
        allow create: if (isActiveUser() && isChatParty(chatId, request.auth.uid) && isValidChatMessage(chatId)) || isAdminOrStaff();
        allow update, delete: if isAdminOrStaff();
      }
    }

    // Support Chats Collection: keyed by the user's uid; the support desk is staff/agents (isAdminOrStaff).
    match /support_chats/{chatId} {
      allow read: if isOwner(chatId) || isAdminOrStaff();
      allow write: if (isOwner(chatId) && isActiveUser()) || isAdminOrStaff();
      match /messages/{messageId} {
        allow read: if isOwner(chatId) || isAdminOrStaff();
        allow create: if (isOwner(chatId) && isActiveUser() && request.resource.data.senderId == request.auth.uid) || isAdminOrStaff();
        allow update, delete: if isAdminOrStaff();
      }
    }

    // Support ticket create: only the web profile_view.dart submitTicket writes these (uid, userEmail, userName,
    // subject, description, category, status 'Open', createdAt epoch ms). Mobile writes none; the admin panel
    // (staff) handles everything else, so owners never update or delete.
    function isValidTicketCreate() {
      let d = request.resource.data;
      return isActiveUser() &&
        d.keys().hasOnly(['uid', 'userEmail', 'userName', 'subject', 'description', 'category', 'status', 'createdAt']) &&
        d.keys().hasAll(['uid', 'subject', 'description', 'status', 'createdAt']) &&
        d.uid == request.auth.uid &&
        d.status == 'Open' &&
        d.subject is string && d.subject.size() > 0 && d.subject.size() <= 200 &&
        d.description is string && d.description.size() > 0 && d.description.size() <= 5000 &&
        d.get('category', '') is string && d.get('category', '').size() <= 50 &&
        d.get('userName', '') is string && d.get('userName', '').size() <= 100 &&
        d.get('userEmail', '') is string && d.get('userEmail', '').size() <= 254 &&
        d.createdAt is number &&
        d.createdAt >= request.time.toMillis() - 600000 && d.createdAt <= request.time.toMillis() + 600000;
    }

    // KAN-143 follow-up: ticket owner = the parent ticket's uid/userId (web writes uid). Replies are written
    // only by the admin panel (tickets.dart adds supportTickets/<id>/responses as staff); no web or mobile
    // client reads or writes them, so they are owner-read, staff-write.
    function isTicketOwner(ticketPath) {
      return exists(ticketPath) && (
        get(ticketPath).data.get('uid', '') == request.auth.uid ||
        get(ticketPath).data.get('userId', '') == request.auth.uid);
    }

    // Support Tickets Collections (Cross-platform compatibility)
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.get('uid', '') == request.auth.uid || isAdminOrStaff());
      allow create: if isValidTicketCreate() || isAdminOrStaff();
      allow update, delete: if isAdminOrStaff();
      match /responses/{responseId} {
        allow read: if isAuthenticated() && (isAdminOrStaff() ||
          isTicketOwner(/databases/$(database)/documents/supportTickets/$(ticketId)));
        allow write: if isAdminOrStaff();
      }
    }

    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.get('uid', '') == request.auth.uid || isAdminOrStaff());
      allow create: if isValidTicketCreate() || isAdminOrStaff();
      allow update, delete: if isAdminOrStaff();
      match /responses/{responseId} {
        allow read: if isAuthenticated() && (isAdminOrStaff() ||
          isTicketOwner(/databases/$(database)/documents/support_tickets/$(ticketId)));
        allow write: if isAdminOrStaff();
      }
    }

    // KAN-143: clients only create "flagged_for_ban" tickets about themselves (web index.html, mobile chat
    // views); the owner reads their own, staff do everything else.
    match /tickets/{ticketId} {
      allow read: if isAuthenticated() && (resource.data.get('userId', '') == request.auth.uid || isAdminOrStaff());
      allow create: if (isActiveUser() &&
        request.resource.data.keys().hasOnly([
          'id', 'subject', 'title', 'userId', 'userName', 'chatId', 'reason', 'lastOffendingMessage',
          'violationType', 'status', 'priority', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'flagged_for_ban' &&
        request.resource.data.get('lastOffendingMessage', '') is string &&
        request.resource.data.get('lastOffendingMessage', '').size() <= 2000 &&
        request.resource.data.get('reason', '') is string &&
        request.resource.data.get('reason', '').size() <= 500) || isAdminOrStaff();
      allow update, delete: if isAdminOrStaff();
    }

    function isDisputeParty(disputePath) {
      return exists(disputePath) && (
        get(disputePath).data.get('openedBy', '') == request.auth.uid ||
        get(disputePath).data.get('employerId', '') == request.auth.uid ||
        get(disputePath).data.get('acceptedNyxianId', '') == request.auth.uid);
    }

    // Disputes Collection (Review and resolution portal)
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.openedBy == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        resource.data.acceptedNyxianId == request.auth.uid ||
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        request.resource.data.openedBy == request.auth.uid ||
        isAdminOrStaff()
      ) && (request.resource.data.status == 'OPEN' || request.resource.data.status == 'open');
      allow update: if isAdminOrStaff() || (
        isActiveUser() && (
          resource.data.openedBy == request.auth.uid ||
          resource.data.employerId == request.auth.uid ||
          resource.data.acceptedNyxianId == request.auth.uid
        ) &&
        // Non-admin participants CANNOT alter dispute resolution or status to RESOLVED
        request.resource.data.status == resource.data.status &&
        !('resolutionPathway' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('resolvedAt' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('resolvedBy' in request.resource.data.diff(resource.data).affectedKeys())
      );
      allow delete: if isAdminOrStaff();

      // KAN-143 follow-up: only the dispute's parties and staff. No web or mobile client or the admin panel
      // reads or writes this subcollection today; parties may add messages as themselves, staff moderate.
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (isAdminOrStaff() ||
          isDisputeParty(/databases/$(database)/documents/disputes/$(disputeId)));
        allow create: if isAdminOrStaff() || (isActiveUser() &&
          isDisputeParty(/databases/$(database)/documents/disputes/$(disputeId)) &&
          request.resource.data.get('senderId', '') == request.auth.uid &&
          request.resource.data.get('text', '') is string &&
          request.resource.data.get('text', '').size() <= 2000);
        allow update, delete: if isAdminOrStaff();
      }

      match /notes/{noteId} {
        allow read, write: if isAdminOrStaff();
      }
    }

// >>> SOURCE: firestore_rules/60_admin_portal_operations.rules
    // ------------------------------------------------------------------------
    // ADMIN PORTAL OPERATIONS, P2P DESK & SYSTEM CONFIGURATION
    // ------------------------------------------------------------------------

    // P2P Agents Collection (Publicly readable verified agent QR credentials)
    match /p2p_agents/{agentId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // Unified Requests Collection (Admin Portal: Enforces 3-Min Claim Limit & Single-Agent Lock)
    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdminOrStaff();
      
      allow update: if isAuthenticated() && (
        isAdminOrStaff() ||
        // 1. Agent accepting their assignment WITHIN 3 minutes
        (
          resource.data.status == 'ASSIGNED' && 
          (resource.data.assignedTo == request.auth.uid || resource.data.assignedAgentId == request.auth.uid) &&
          (resource.data.claimDeadline == null || request.time < resource.data.claimDeadline)
        ) ||
        // 2. Any agent taking a request whose claimDeadline HAS PASSED
        (
          resource.data.status == 'ASSIGNED' && 
          resource.data.claimDeadline != null &&
          request.time > resource.data.claimDeadline
        ) ||
        // 3. Claiming an unassigned pending request
        (
          (resource.data.status == 'PENDING' || resource.data.status == 'OPEN') && 
          (resource.data.assignedTo == null || resource.data.assignedAgentId == null)
        ) ||
        // 4. Updating an active IN_PROGRESS request owned by self
        (
          (resource.data.status == 'IN_PROGRESS' || resource.data.status == 'In Progress') && 
          (resource.data.assignedTo == request.auth.uid || resource.data.assignedAgentId == request.auth.uid)
        )
      );
    }

    // Email & Mail Logging Collections
    // KAN-143: mail/emails are written only by the admin panel (ticket_email_service) and read by the mail
    // extension (Admin SDK); no web/mobile client touches them, so signed-in users cannot relay or read mail.
    match /mail/{mailId} {
      allow read, write: if isAdminOrStaff();
    }
    match /emails/{mailId} {
      allow read, write: if isAdminOrStaff();
    }

    // Audit Logs Collections (KAN-143: no client writes them; the admin panel uses admin_audit_logs)
    match /audit_logs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    match /auditLogs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    match /system_logs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    // System Config Collection (Treasury keys and backend config - Admin only!)
    match /system_config/{docId} {
      allow read, write: if isAdminOrStaff();
    }
    match /system_config/{docId}/{subPath=**} {
      allow read, write: if isAdminOrStaff();
    }

    // Config Collection. Clients only read config/app_config; third-party API docs (e.g. config/imgbb) are admin only.
    match /config/{docId} {
      allow read: if isAdminOrStaff() || (isAuthenticated() && docId == 'app_config');
      allow write: if isAdminOrStaff();
    }

    // Platform Fees Collection (Admin managed). Client creates stay Function-only (KAN-136-P1 / D10).
    match /platform_fees/{feeId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrStaff();
    }

    // settings/platform_fees: the fee rates the web/mobile apps read before showing a gig/booking total.
    // Everything else under settings stays closed. Writes are admin/staff only (the server reads it with the Admin SDK).
    // Audit trail of staffOps (balance / cashout / dispute actions): Admin SDK writes only, staff read.
    match /staff_audit_log/{opId} {
      allow read: if isAdminOrStaff();
      allow write: if false;
    }

    match /settings/{docId} {
      allow read: if isAuthenticated() && docId == 'platform_fees';
      allow write: if isAdminOrStaff();
    }

    // Platform Config Collection (Job SLAs, Platform Settings - Admin managed)
    match /platform_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrStaff();
    }
    match /platform_config/{docId}/{subPath=**} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrStaff();
    }

    // Promos Collection
    match /promos/{promoId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdminOrStaff();
      allow update: if isAdminOrStaff() || 
        (isActiveUser() && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'usedBy']));
    }

    // Promo Audit Trail Collection
    match /promo_audit_trail/{auditId} {
      allow read, write: if isAdminOrStaff();
    }

    // News & Promotions Collections
    match /news_posts/{postId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // KYC Submissions Collection
    match /kyc_submissions/{submissionId} {
      allow read: if isAuthenticated() && (request.auth.uid == submissionId || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow write: if (isActiveUser() && (request.auth.uid == submissionId)) || isAdminOrStaff();
    }

    // Agent & Staff Realtime Presence Collection
    match /presence/{agentId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isOwner(agentId) || isAdminOrStaff());
    }

// >>> SOURCE: firestore_rules/99_footer.rules
    // ------------------------------------------------------------------------
    // COLLECTION GROUP QUERIES & ROOT CLOSING
    // ------------------------------------------------------------------------

    match /{path=**}/applications/{applicantId} {
      allow read: if isActiveUser() || isAdminOrStaff();
    }

    match /{path=**}/questions/{questionId} {
      allow read: if true;
      allow write: if isActiveUser();
    }

    match /{path=**}/qna/{qnaId} {
      allow read: if true;
      allow write: if isActiveUser() || isAdminOrStaff();
    }
  }
}

