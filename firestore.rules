// >>> SOURCE: firestore_rules/00_header.rules
// ============================================================================
// TRANYX CLOUD FIRESTORE SECURITY RULES (MODULAR SOURCE)
// DO NOT DIRECTLY EDIT firestore.rules!
// Edit the modular source files in firestore_rules/ and run:
//   dart run tool/build_rules.dart
// ============================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

// >>> SOURCE: firestore_rules/01_common_auth.rules
    // ------------------------------------------------------------------------
    // COMMON AUTHENTICATION & IDENTITY HELPERS
    // ------------------------------------------------------------------------

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if the user is accessing their own document or matches the user ID
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check if a user is currently banned or suspended
    function isUserBlocked(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      let docExists = exists(path);
      let userDoc = docExists ? get(path).data : {};
      return docExists && (
        ('banned' in userDoc && userDoc.banned == true) ||
        ('suspendedUntil' in userDoc && userDoc.suspendedUntil is int && userDoc.suspendedUntil > request.time.toMillis())
      );
    }

    // Helper to check if current request user is authenticated and NOT blocked
    function isActiveUser() {
      return isAuthenticated() && !isUserBlocked(request.auth.uid);
    }

// >>> SOURCE: firestore_rules/02_admin_helpers.rules
    // ------------------------------------------------------------------------
    // ADMINISTRATIVE & STAFF AUTHORIZATION HELPERS
    // ------------------------------------------------------------------------

    // Helper to check if the user has an official staff/admin email domain
    function isStaffEmail() {
      return isAuthenticated() && request.auth.token.email != null && (
        request.auth.token.email.matches('.*\\.(agents|agent|admin|staff)@tranyx\\.(app|com|ph)$') ||
        request.auth.token.email.matches('.*@(admin|staff|agents|agent)\\.tranyx\\.(app|com|ph)$') ||
        request.auth.token.email.matches('.*@(tranyx\\.app|tranyx\\.ph|tranyx\\.com|terra\\.app|tranyx\\.dev)$')
      );
    }

    // Step 1: Zero-read instant verification via Auth Token Claims & Verified Staff Email
    function isAdminTokenOrEmail() {
      return isAuthenticated() && (
        (request.auth.token != null && (
          ('admin' in request.auth.token && request.auth.token.admin == true) ||
          ('superadmin' in request.auth.token && request.auth.token.superadmin == true) ||
          ('role' in request.auth.token && (
            request.auth.token.role in [
              'admin', 'staff', 'support', 'agent', 'super_admin', 'superadmin',
              'ADMIN', 'STAFF', 'AGENT', 'SUPER_ADMIN'
            ]
          ))
        )) ||
        (request.auth.token.email != null &&
         request.auth.token.email_verified == true &&
         request.auth.token.email.matches('.*@(tranyx\\.app|tranyx\\.com|tranyx\\.ph|terra\\.app|tranyx\\.dev)$'))
      );
    }

    // Step 2: Lazy fallback check on /users/{uid} document
    function isUserAdminInDoc() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let userDoc = exists(userPath) ? get(userPath).data : {};
      return ('isAdmin' in userDoc && userDoc.isAdmin == true) ||
        ('isStaff' in userDoc && userDoc.isStaff == true) ||
        ('isSuperAdmin' in userDoc && userDoc.isSuperAdmin == true) ||
        ('isP2pAgent' in userDoc && userDoc.isP2pAgent == true) ||
        ('role' in userDoc && (
          userDoc.role in [
            'admin', 'staff', 'support', 'agent', 'p2p_agent', 'super_admin', 'superadmin',
            'ADMIN', 'STAFF', 'AGENT', 'SUPPORT', 'SUPER_ADMIN', 'SUPERADMIN'
          ]
        ));
    }

    // Step 3: Lazy check on /p2p_agents/{uid} document
    function isP2pAgentInDoc() {
      return exists(/databases/$(database)/documents/p2p_agents/$(request.auth.uid));
    }

    // Helper to check if the user is an admin, staff member, or registered P2P agent
    function isAdminOrStaff() {
      return isAdminTokenOrEmail() || (isAuthenticated() && (isUserAdminInDoc() || isP2pAgentInDoc()));
    }

// >>> SOURCE: firestore_rules/10_workspace_users_wallets.rules
    // ------------------------------------------------------------------------
    // WORKSPACE: USERS, WALLETS, TRANSACTIONS & FINANCES
    // ------------------------------------------------------------------------

    // Users Collection (Strict segregation of User vs Admin fields)
    match /users/{userId} {
      allow read: if true; // Publicly readable profiles (ratings/reviews)
      
      // Regular users can create their profile without privileged fields.
      // Verified staff emails or admins can bootstrap administrative roles.
      allow create: if (
        (isOwner(userId) && !request.resource.data.keys().hasAny(['role', 'banned', 'suspendedUntil'])) ||
        (isOwner(userId) && isStaffEmail()) ||
        isAdminOrStaff()
      ) &&
      (!('tyxBalance' in request.resource.data) || (request.resource.data.tyxBalance is number && request.resource.data.tyxBalance >= 0));

      allow update: if (
        // 1. Regular User: Can update own profile fields (cannot alter admin role, ban, or suspension status)
        (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'isAdmin', 'isStaff', 'isSuperAdmin', 'isP2pAgent', 'banned', 'suspendedUntil', 'tyxBalance'
        ]))
        || 
        // 2. Staff Bootstrap: User with official staff email domain can bootstrap staff role
        (isOwner(userId) && isStaffEmail())
        ||
        // 3. Admin / Staff: Can update admin, moderation & verification fields
        isAdminOrStaff()
        ||
        // 4. Subscription verification & activation updates
        (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isPremium', 'premiumUntil', 'accountType', 'subscriptionPlan', 
          'subscriptionStartedAt', 'subscriptionPaymentMethod', 'subscriptionPaymentAmount', 
          'subscriptionTxId', 'subscriptionStatus', 'pendingSubscription', 
          'lastSubscriptionRejection', 'updatedAt'
        ]))
        ||
        // 5. Inactive gig reclaim: Allow incrementing worker's abandonedJobs metric
        (isActiveUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abandonedJobs']) &&
          request.resource.data.abandonedJobs is number &&
          (!('abandonedJobs' in resource.data) || request.resource.data.abandonedJobs == resource.data.abandonedJobs + 1)
        )
      ) &&
      (!('tyxBalance' in request.resource.data) || (request.resource.data.tyxBalance is number && request.resource.data.tyxBalance >= 0));

      allow delete: if isAdminOrStaff();
      
      // User Reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if isActiveUser() && request.resource.data.authorId == request.auth.uid;
      }

      // User Ledger subcollection
      match /ledger/{ledgerId} {
        allow read, write: if isOwner(userId) || isAdminOrStaff();
      }

      // User Transactions subcollection
      match /transactions/{txId} {
        allow read, write: if isOwner(userId) || isAdminOrStaff();
      }

      // User Points subcollection
      match /points/{docId} {
        allow read, write: if isOwner(userId) || isAdminOrStaff();
      }
    }

    // Wallets Collection (Unified wallet storage & user ledger sub-collections)
    match /wallets/{walletId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.uid == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow write: if (isOwner(walletId) || isAdminOrStaff()) &&
        (!('balance' in request.resource.data) || (request.resource.data.balance is number && request.resource.data.balance >= 0));

      match /transactions/{txId} {
        allow read, write: if isAuthenticated() && (walletId == request.auth.uid || isAdminOrStaff());
        allow delete: if isAdminOrStaff();
      }

      match /ledger/{entryDoc} {
        allow read, write: if isAuthenticated() && (walletId == request.auth.uid || isAdminOrStaff());
        allow delete: if isAdminOrStaff();
      }
    }

    // Wallet Links Collection
    match /walletLinks/{walletPublicKey} {
      allow read: if true;
      allow write: if isActiveUser() && request.resource.data.uid == request.auth.uid;
    }

    // Global Transactions Collection
    match /transactions/{txId} {
      allow read: if true;
      allow create: if isAdminOrStaff() || (isActiveUser() && request.resource.data.uid == request.auth.uid && !request.resource.data.type.matches('^(payout|rebate|fee_deduction)$'));
      allow update: if isAdminOrStaff() || (isActiveUser() && resource.data.uid == request.auth.uid) || (isAuthenticated() && (resource.data.type == 'subscription' || resource.data.kind == 'subscription'));
      allow delete: if isAdminOrStaff();
    }

    // Subscriptions Collection (P2P Hybrid PRO Subscriptions)
    match /subscriptions/{subId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAdminOrStaff() || isAuthenticated();
      allow delete: if isAdminOrStaff();
    }

    // Deposit Requests Collections (Dual-collection sync: deposit_requests & depositRequests)
    match /deposit_requests/{reqId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    match /depositRequests/{requestId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    match /deposits/{depositId} {
      allow read, write: if isAuthenticated();
    }

    // Withdrawal Requests Collections (Dual-collection sync: withdrawal_requests & withdrawalRequests)
    match /withdrawal_requests/{reqId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    match /withdrawalRequests/{requestId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow create: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || request.resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow update: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    match /withdrawals/{requestId} {
      allow read, write: if isAuthenticated();
    }

    match /cashout_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // Deposit References & Claimed References Collections
    match /deposit_references/{refKey} {
      allow read, write: if isAuthenticated();
    }

    match /claimed_references/{refKey} {
      allow read, write: if isAuthenticated();
    }

    match /claimed_p2p_references/{refKey} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdminOrStaff();
    }

    match /claimedReferences/{refKey} {
      allow read, write: if isAuthenticated();
    }

    // Points History Collection
    match /points_history/{historyId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow write: if (isActiveUser() && request.resource.data.uid == request.auth.uid) || isAdminOrStaff();
    }

// >>> SOURCE: firestore_rules/20_workspace_rentals.rules
    // ------------------------------------------------------------------------
    // WORKSPACE: VEHICLE RENTALS & ESCROWS
    // ------------------------------------------------------------------------

    // Helper to validate vehicle rental pricing constraints
    function isValidVehiclePricing(data) {
      let priceDaily = ('priceDaily' in data && data.priceDaily is number) ? data.priceDaily : 0.0;
      let price12h = ('price12h' in data && data.price12h is number) ? data.price12h : 0.0;
      let priceWeekly = ('priceWeekly' in data && data.priceWeekly is number) ? data.priceWeekly : 0.0;
      let priceMonthly = ('priceMonthly' in data && data.priceMonthly is number) ? data.priceMonthly : 0.0;
      return priceDaily > 0.0 &&
        (price12h == 0.0 || (price12h >= priceDaily * 0.4 && price12h <= priceDaily)) &&
        (priceWeekly == 0.0 || (priceWeekly >= priceDaily * 3.5 && priceWeekly > priceDaily)) &&
        (priceMonthly == 0.0 || (priceMonthly >= priceDaily * 12.0 && (priceWeekly == 0.0 || priceMonthly > priceWeekly)));
    }

    // Helper to check if current user is the renter, rentee, or host of an escrow
    function isRentalEscrowParty(data) {
      return ('renterId' in data && data.renterId == request.auth.uid) || 
             ('renteeId' in data && data.renteeId == request.auth.uid) || 
             ('hostId' in data && data.hostId == request.auth.uid);
    }

    // Vehicle Rentals Collection (Anti-Exploitation: Host CANNOT alter pricing once booked)
    match /rentals/{rentalId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid && isValidVehiclePricing(request.resource.data);
      
      allow update: if 
        // 1. Host (Vehicle Owner): Can update vehicle/price details & accept bookings when status is Available
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          (resource.data.status == 'Available' || resource.data.status == 'available') &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['priceDaily', 'price12h', 'priceWeekly', 'priceMonthly']) ||
           isValidVehiclePricing(request.resource.data)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'brand', 'model', 'year', 'type', 'plateNumber', 'vehicleValue', 
            'ltoCrNumber', 'ltoOrNumber', 'insuranceProvider', 'insurancePolicyNumber', 
            'franchisePermit', 'interiorPhotoUrl', 'frontPhotoUrl', 'backPhotoUrl', 
            'contractType', 'contractTerms', 'price12h', 'priceDaily', 'priceWeekly', 
            'priceMonthly', 'extensionRatePerHour', 'latePenaltyRatePerHour', 'status', 
            'fuelType', 'transmission', 'offersDriver', 'driverDailyPrice', 'driverNote', 
            'driverLicenseNumber', 'renteeId', 'renteeName', 'renteePhotoUrl', 
            'renteePhone', 'renteeRating', 'startEpoch', 'endEpoch', 'expectedReturnEpoch', 
            'deliveryType', 'deliveryAddress', 'deliveryFee', 'currentLocationLat', 
            'currentLocationLng', 'fuelLevel', 'odoMeter', 'pickupPhotos', 
            'dropoffPhotos', 'hostRated', 'renteeRated',
            // Booking acceptance & contract metadata
            'rentalDurationType', 'rentalMultiplier', 'startDate', 'endDate', 
            'totalCost', 'bookingFee', 'renteeSignatureName', 'renteeLicenseNumber', 
            'signedAt', 'trackingLat', 'trackingLng', 'hireWithDriver', 'rentalType', 
            'currentRequestId', 'allowChat', 'verificationSelfieUrl', 
            'verificationGovtIdUrl', 'verificationStatus', 'hostIsVerified', 
            'hostVerificationStatus', 'hostVerificationTier', 'renteeIsVerified', 
            'renteeVerificationStatus', 'renteeVerificationTier',
            // Listing deletion, archival, pause/resume & GPS tracking
            'isDeleted', 'acceptingBookings', 'deletedAt', 'gpsTrackerId'
          ])
        ) ||
        // 1b. Host: When awaiting signature, can revoke approval (back to Available) or activate lease
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          (resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeId', 'renteeName', 'renteePhotoUrl', 'startDate', 
            'endDate', 'totalCost', 'bookingFee', 'currentRequestId', 
            'renteeSignatureName', 'signedAt', 'allowChat'
          ])
        ) ||
        // 1c. Host: When vehicle is active/booked, can submit rating, accept extensions, update tracking, or complete/reset rental
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          resource.data.status != 'Available' && resource.data.status != 'available' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hostRated', 'endDate', 'totalCost', 'status', 'trackingLat', 'trackingLng',
            'renteeId', 'renteeName', 'renteePhotoUrl', 'rentalDurationType', 'rentalMultiplier',
            'startDate', 'bookingFee', 'renteeSignatureName', 'renteeLicenseNumber', 'signedAt',
            'currentRequestId', 'allowChat'
          ])
        ) ||
        // 2a. Assigned Rentee: Can sign contract when status is Awaiting Signature
        (isActiveUser() && 
          ((resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
           (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
            ('renterId' in resource.data && resource.data.renterId == request.auth.uid) ||
            ('currentRequestId' in resource.data))) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeSignatureName', 'signedAt', 'signatureHash', 
            'currentRequestId', 'renteeLicenseNumber'
          ])
        ) ||
        // 2b. Assigned Rentee: When active, can update trip status, return info, location, extensions & rating
        (isActiveUser() && 
          (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
           ('renterId' in resource.data && resource.data.renterId == request.auth.uid)) && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'currentLocationLat', 'currentLocationLng', 'fuelLevel', 
            'odoMeter', 'dropoffPhotos', 'renteeRated', 'endDate', 'totalCost'
          ])
        ) ||
        // 3. Admin / Staff
        isAdminOrStaff();

      allow delete: if (isActiveUser() && resource.data.hostId == request.auth.uid && (resource.data.status == 'Available' || resource.data.status == 'available')) || isAdminOrStaff();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }

      match /qna/{qnaId} {
        allow read: if true;
        allow write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Rental Requests Collection
    match /rental_requests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Rental Extensions Collection
    match /rental_extensions/{extId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Rental History Collection
    match /rental_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Rental Escrows Collection (Dual-field support for renteeId & renterId)
    match /rental_escrows/{rentalId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      allow create, update: if isActiveUser() && (
        isRentalEscrowParty(request.resource.data) || 
        isAdminOrStaff()
      );
      allow delete: if (isActiveUser() && isRentalEscrowParty(resource.data)) || isAdminOrStaff();
    }

    // Rental Extension Escrows Collection
    match /rental_extension_escrows/{extensionId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      allow create, update: if isActiveUser() && (
        isRentalEscrowParty(request.resource.data) || 
        isAdminOrStaff()
      );
      allow delete: if (isActiveUser() && isRentalEscrowParty(resource.data)) || isAdminOrStaff();
    }

    // Rental Contracts Collection (Permanent immutable contract snapshots)
    match /rental_contracts/{contractId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        isRentalEscrowParty(request.resource.data) || 
        isAdminOrStaff()
      );
      allow update, delete: if isAdminOrStaff();
    }

// >>> SOURCE: firestore_rules/30_workspace_jobs.rules
    // ------------------------------------------------------------------------
    // WORKSPACE: JOBS, APPLICATIONS, ESCROWS & REPUTATION
    // ------------------------------------------------------------------------

    // Jobs Collection (Anti-Exploitation: Employer CANNOT alter terms once hired)
    match /jobs/{jobId} {
      allow read: if true; // Publicly browse jobs
      allow create: if isActiveUser() && request.resource.data.creatorId == request.auth.uid;
      
      allow update: if 
        // 1. Creator (Employer): Can update listing details ONLY when job status is Open or Reviewing
        (isActiveUser() && resource.data.creatorId == request.auth.uid && 
          (resource.data.status == 'Open' || resource.data.status == 'open' || resource.data.status == 'Reviewing' || resource.data.status == 'reviewing') &&
          (!('acceptedApplicantId' in resource.data) || resource.data.acceptedApplicantId == null || resource.data.acceptedApplicantId == '') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'id', 'title', 'description', 'category', 'categoryGroup', 'employmentType', 
            'dateRequirement', 'jobDate', 'timePreference', 'pricingType', 'pricingValue', 
            'locationType', 'address', 'landmark', 'status', 'applicantCount', 
            'recentApplicantPhotos', 'applicantUids', 'pickupAddress', 'pickupLat', 
            'pickupLng', 'destinationAddress', 'destinationLat', 'destinationLng', 
            'hasTracker', 'hasInspectionHoldback', 'imageUrls', 'acceptedApplicantId', 
            'acceptedApplicantName', 'completionCode', 'receiptUrl', 'employerRated', 
            'nyxianRated', 'promoCode', 'discountAmount', 'creatorPhotoUrl', 
            'creatorName', 'creatorType', 'createdAt', 'updatedAt',
            'acknowledgmentDeadline', 'acknowledgmentSlaMinutes', 'acknowledgmentCategory',
            'acknowledgmentStatus', 'acknowledgedAt', 'hiredAt', 'acknowledgmentReminderSent'
          ])
        ) ||
        // 1b. Creator (Employer): Resetting, re-opening or cancelling an unacknowledged or expired job
        (isActiveUser() && resource.data.creatorId == request.auth.uid &&
          (resource.data.status == 'Awaiting Acknowledgment' || resource.data.status == 'awaiting acknowledgment' ||
           resource.data.status == 'Acknowledgment Expired' || resource.data.status == 'acknowledgment expired') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acceptedApplicantId', 'acceptedApplicantName', 'updatedAt',
            'acknowledgmentDeadline', 'acknowledgmentSlaMinutes', 'acknowledgmentCategory',
            'acknowledgmentStatus', 'acknowledgedAt', 'hiredAt', 'acknowledgmentReminderSent'
          ])
        ) ||
        // 1c. Creator (Employer): When job is completed/active, can ONLY submit employer rating
        (isActiveUser() && resource.data.creatorId == request.auth.uid && 
          resource.data.status != 'Open' && resource.data.status != 'open' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['employerRated'])
        ) ||
        // 1d. Creator (Employer): Reclaiming an inactive/stalled job and marking it Abandoned
        (isActiveUser() && resource.data.creatorId == request.auth.uid &&
          (request.resource.data.status == 'Abandoned' || request.resource.data.status == 'abandoned') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'abandonedAt', 'abandonReason', 'updatedAt'
          ])
        ) ||
        // 1e. Active Participants: Raising a dispute for admin arbitration
        (isActiveUser() && (resource.data.creatorId == request.auth.uid || ('acceptedApplicantId' in resource.data && resource.data.acceptedApplicantId == request.auth.uid)) &&
          (request.resource.data.status == 'Disputed' || request.resource.data.status == 'disputed') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'disputeId', 'disputedAt', 'disputedBy', 'updatedAt'
          ])
        ) ||
        // Active participants can touch lastActivityAt
        (isActiveUser() && (resource.data.creatorId == request.auth.uid || ('acceptedApplicantId' in resource.data && resource.data.acceptedApplicantId == request.auth.uid)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt'])
        ) ||
        // 2. Assigned Nyxian (Freelancer): Can update work progress, status & completion fields
        (isActiveUser() && 'acceptedApplicantId' in resource.data && resource.data.acceptedApplicantId == request.auth.uid && 
          (
            !('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
            request.resource.data.status == resource.data.status ||
            (
              request.resource.data.status in [
                'In Progress', 'in progress', 'arrived_pickup', 'paid_cashier',
                'in_transit', 'arrived_dropoff', 'Done', 'done', 'Completed', 'completed'
              ] &&
              resource.data.status in [
                'Awaiting Acknowledgment', 'awaiting acknowledgment',
                'In Progress', 'in progress', 'arrived_pickup', 'paid_cashier',
                'in_transit', 'arrived_dropoff', 'Done', 'done'
              ]
            )
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'completionCode', 'receiptUrl', 'nyxianRated',
            'acknowledgedAt', 'acknowledgmentStatus', 'updatedAt'
          ])
        ) ||
        // 2b. SLA Expiration or Reminder update by active participants
        (isActiveUser() && (resource.data.creatorId == request.auth.uid || ('acceptedApplicantId' in resource.data && resource.data.acceptedApplicantId == request.auth.uid)) &&
          (resource.data.status == 'Awaiting Acknowledgment' || resource.data.status == 'awaiting acknowledgment') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acknowledgmentStatus', 'acknowledgmentReminderSent', 'updatedAt'
          ])
        ) ||
        // 3. Any Active Applicant: Can apply to or withdraw from an Open/Reviewing job
        (isActiveUser() && 
          (resource.data.status == 'Open' || resource.data.status == 'open' || resource.data.status == 'Reviewing' || resource.data.status == 'reviewing') &&
          (!('acceptedApplicantId' in resource.data) || resource.data.acceptedApplicantId == null || resource.data.acceptedApplicantId == '') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'applicantCount', 'applicantUids', 'recentApplicantPhotos'
          ])
        ) ||
        // 4. Admin / Staff
        isAdminOrStaff();

      allow delete: if (isActiveUser() && resource.data.creatorId == request.auth.uid && (
        resource.data.status == 'Open' || 
        resource.data.status == 'open' || 
        resource.data.status == 'Cancelled' || 
        resource.data.status == 'cancelled'
      )) || isAdminOrStaff();

      // Subcollection: Applications
      match /applications/{applicantId} {
        allow read: if isAuthenticated();
        allow create, update: if (
          (isActiveUser() && (
            request.auth.uid == applicantId ||
            (resource != null && (resource.data.applicantId == request.auth.uid || resource.data.applicantUid == request.auth.uid)) ||
            get(/databases/$(database)/documents/jobs/$(jobId)).data.creatorId == request.auth.uid
          )) ||
          isAdminOrStaff()
        ) && (
          // Standard rate bids
          request.resource.data.isCounterOffer != true ||
          // Counter offers: strictly positive (> 0) and restricted to 80% - 150% of the job's pricingValue
          (
            request.resource.data.proposalRate is number &&
            request.resource.data.proposalRate > 0 &&
            get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue is number &&
            get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue > 0 &&
            request.resource.data.proposalRate >= (get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue * 0.8) - 0.01 &&
            request.resource.data.proposalRate <= (get(/databases/$(database)/documents/jobs/$(jobId)).data.pricingValue * 1.5) + 0.01
          )
        );
        allow delete: if (isActiveUser() && (
          request.auth.uid == applicantId ||
          (resource != null && (resource.data.applicantId == request.auth.uid || resource.data.applicantUid == request.auth.uid))
        )) || isAdminOrStaff();
      }

      // Subcollection: Messages (Job chat room)
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow write: if isActiveUser() || isAdminOrStaff();
      }

      // Subcollection: Questions (Public Q&A)
      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }

      // Subcollection: QnA (Public Q&A alternative path)
      match /qna/{qnaId} {
        allow read: if true;
        allow write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Job Escrow Collection
    match /escrow/{jobId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        resource.data.creatorId == request.auth.uid || 
        resource.data.employerId == request.auth.uid || 
        resource.data.workerId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        request.resource.data.employerId == request.auth.uid || 
        request.resource.data.creatorId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow update: if isActiveUser() && (
        resource.data.employerId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid || 
        isAdminOrStaff()
      );
      allow delete: if (isActiveUser() && (
        resource.data.employerId == request.auth.uid || 
        resource.data.creatorId == request.auth.uid ||
        (exists(/databases/$(database)/documents/jobs/$(jobId)) && 
         get(/databases/$(database)/documents/jobs/$(jobId)).data.acceptedApplicantId == request.auth.uid)
      )) || isAdminOrStaff();
    }

    // Escrow Holdbacks Collection
    match /escrow_holdbacks/{holdbackId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || resource.data.employerId == request.auth.uid || isAdminOrStaff());
      allow create, update: if isActiveUser() && (request.resource.data.uid == request.auth.uid || request.resource.data.employerId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

    // Job Cancellation Audit Logs Collection
    match /job_cancellation_logs/{logId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.cancelledBy == request.auth.uid ||
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        request.resource.data.cancelledBy == request.auth.uid ||
        isAdminOrStaff()
      );
      allow update, delete: if isAdminOrStaff();
    }

// >>> SOURCE: firestore_rules/40_workspace_properties.rules
    // ------------------------------------------------------------------------
    // WORKSPACE: PROPERTY RENTALS, LEASES & CONTRACT DOCUMENTS
    // ------------------------------------------------------------------------

    // Properties Collection (Anti-Exploitation: Host CANNOT alter pricing/rules once booked)
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid;
      
      allow update: if 
        // 1. Host (Property Owner): Can update property details & accept bookings when status is Available
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          (resource.data.status == 'Available' || resource.data.status == 'available') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'propertyType', 'address', 'landmark', 
            'lat', 'lng', 'bedrooms', 'bathrooms', 'maxGuests', 'nightlyPrice', 
            'weeklyDiscount', 'monthlyDiscount', 'cleaningFee', 'depositAmount', 
            'amenities', 'houseRules', 'images', 'contractType', 'contractTerms', 
            'status', 'renteeId', 'renteeName', 'renteePhotoUrl', 'checkInDate', 
            'checkOutDate', 'hostRated', 'renteeRated',
            // Booking acceptance & lease metadata
            'rentalDurationType', 'rentalMultiplier', 'startDate', 'endDate', 
            'totalCost', 'baseRentAmount', 'securityDepositAmount', 'bookingFee', 
            'customerPlatformFeeRate', 'hostCommissionRate', 'renteeSignatureName', 
            'signedAt', 'currentRequestId', 'allowChat', 'licenseNumber', 
            'verificationSelfieUrl', 'verificationGovtIdUrl', 'verificationStatus', 
            'hostIsVerified', 'hostVerificationStatus', 'hostVerificationTier', 
            'renteeIsVerified', 'renteeVerificationStatus', 'renteeVerificationTier',
            // Listing deletion, archival & pause/resume
            'isDeleted', 'acceptingBookings', 'deletedAt'
          ])
        ) ||
        // 1b. Host: When awaiting signature, can revoke approval (back to Available) or activate lease
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          (resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeId', 'renteeName', 'renteePhotoUrl', 'rentalDurationType', 
            'rentalMultiplier', 'startDate', 'endDate', 'checkInDate', 'checkOutDate', 
            'totalCost', 'baseRentAmount', 'securityDepositAmount', 'bookingFee', 
            'currentRequestId', 'renteeSignatureName', 'signedAt', 'licenseNumber', 'allowChat'
          ])
        ) ||
        // 1c. Host: When property is active/booked, can submit rating, accept extensions, or update status
        (isActiveUser() && resource.data.hostId == request.auth.uid && 
          resource.data.status != 'Available' && resource.data.status != 'available' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hostRated', 'endDate', 'checkOutDate', 'totalCost', 'status'
          ])
        ) ||
        // 2a. Assigned Rentee: Can sign contract when status is Awaiting Signature
        (isActiveUser() && 
          ((resource.data.status == 'Awaiting Signature' || resource.data.status == 'awaiting signature') &&
           (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
            ('renterId' in resource.data && resource.data.renterId == request.auth.uid) ||
            ('currentRequestId' in resource.data))) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeSignatureName', 'signedAt', 'signatureHash', 
            'currentRequestId', 'licenseNumber'
          ])
        ) ||
        // 2b. Assigned Rentee: When active, can update booking status, extensions & guest rating
        (isActiveUser() && 
          (('renteeId' in resource.data && resource.data.renteeId == request.auth.uid) ||
           ('renterId' in resource.data && resource.data.renterId == request.auth.uid)) && 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'renteeRated', 'endDate', 'checkOutDate', 'totalCost'
          ])
        ) ||
        // 3. Admin / Staff
        isAdminOrStaff();

      allow delete: if (isActiveUser() && resource.data.hostId == request.auth.uid && (resource.data.status == 'Available' || resource.data.status == 'available')) || isAdminOrStaff();

      match /questions/{questionId} {
        allow read: if true;
        allow write: if isActiveUser();
      }

      match /qna/{qnaId} {
        allow read: if true;
        allow write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Property Requests Collection
    match /property_requests/{requestId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Property Escrows Collection (Dual-field support for renteeId & renterId)
    match /property_escrows/{requestId} {
      allow read: if isAuthenticated() && (
        resource == null || 
        isRentalEscrowParty(resource.data) || 
        isAdminOrStaff()
      );
      allow create, update: if isActiveUser() && (
        isRentalEscrowParty(request.resource.data) || 
        isAdminOrStaff()
      );
      allow delete: if (isActiveUser() && isRentalEscrowParty(resource.data)) || isAdminOrStaff();
    }

    // Property History Collection
    match /property_history/{historyId} {
      allow read: if isAuthenticated();
      allow write: if isActiveUser() || isAdminOrStaff();
    }

    // Contract Documents Collection (Custom Contract PDFs & Metadata)
    match /contract_documents/{docId} {
      allow read: if true;
      allow create: if isActiveUser() && request.resource.data.hostId == request.auth.uid;
      allow update: if isActiveUser() && (resource.data.hostId == request.auth.uid || isAdminOrStaff());
      allow delete: if isAdminOrStaff();
    }

// >>> SOURCE: firestore_rules/50_workspace_comms.rules
    // ------------------------------------------------------------------------
    // WORKSPACE: CHATS, COMMUNICATIONS, SUPPORT TICKETS & NOTIFICATIONS
    // ------------------------------------------------------------------------

    // Notifications Collection
    match /notifications/{notifId} {
      allow read, update, delete: if resource == null || !('uid' in resource.data) || resource.data.uid == request.auth.uid || isAdminOrStaff() || isAuthenticated();
      allow create: if isActiveUser() || isAuthenticated() || isAdminOrStaff();
    }

    // Direct Chats Collection
    match /chats/{chatId} {
      function isChatParticipant() {
        return (resource != null && 'userIds' in resource.data && request.auth.uid in resource.data.userIds) ||
               (request.resource != null && 'userIds' in request.resource.data && request.auth.uid in request.resource.data.userIds) ||
               chatId.matches('^rental_[^_]+_' + request.auth.uid + '$') ||
               chatId.matches('^property_[^_]+_' + request.auth.uid + '$') ||
               chatId.matches('^support_' + request.auth.uid + '$') ||
               chatId.matches('^job_[^_]+_' + request.auth.uid + '$') ||
               chatId.matches('^' + request.auth.uid + '_.*');
      }

      allow read: if isAdminOrStaff() || (isActiveUser() && isChatParticipant());
      allow write: if isAdminOrStaff() || (isActiveUser() && isChatParticipant());

      match /messages/{messageId} {
        allow read: if isAdminOrStaff() || (isActiveUser() && (
          isChatParticipant() ||
          (resource != null && resource.data.senderId == request.auth.uid)
        ));
        allow write: if isAdminOrStaff() || (isActiveUser() && (
          isChatParticipant() ||
          request.resource.data.senderId == request.auth.uid
        ));
      }
    }

    // Support Chats Collection
    match /support_chats/{chatId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
      match /messages/{messageId} {
        allow read, write: if isActiveUser() || isAdminOrStaff();
      }
    }

    // Support Tickets Collections (Cross-platform compatibility)
    match /supportTickets/{ticketId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
      match /responses/{responseId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /support_tickets/{ticketId} {
      allow read, write: if isActiveUser() || isAdminOrStaff();
      match /responses/{responseId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /tickets/{ticketId} {
      allow read, write: if isAuthenticated();
    }

    // Disputes Collection (Review and resolution portal)
    match /disputes/{disputeId} {
      allow read: if isAuthenticated() && (
        resource == null ||
        resource.data.openedBy == request.auth.uid ||
        resource.data.employerId == request.auth.uid ||
        resource.data.acceptedNyxianId == request.auth.uid ||
        isAdminOrStaff()
      );
      allow create: if isActiveUser() && (
        request.resource.data.openedBy == request.auth.uid ||
        isAdminOrStaff()
      ) && (request.resource.data.status == 'OPEN' || request.resource.data.status == 'open');
      allow update: if isAdminOrStaff() || (
        isActiveUser() && (
          resource.data.openedBy == request.auth.uid ||
          resource.data.employerId == request.auth.uid ||
          resource.data.acceptedNyxianId == request.auth.uid
        ) &&
        // Non-admin participants CANNOT alter dispute resolution or status to RESOLVED
        request.resource.data.status == resource.data.status &&
        !('resolutionPathway' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('resolvedAt' in request.resource.data.diff(resource.data).affectedKeys()) &&
        !('resolvedBy' in request.resource.data.diff(resource.data).affectedKeys())
      );
      allow delete: if isAdminOrStaff();

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }

      match /notes/{noteId} {
        allow read, write: if isAdminOrStaff();
      }
    }

// >>> SOURCE: firestore_rules/60_admin_portal_operations.rules
    // ------------------------------------------------------------------------
    // ADMIN PORTAL OPERATIONS, P2P DESK & SYSTEM CONFIGURATION
    // ------------------------------------------------------------------------

    // P2P Agents Collection (Publicly readable verified agent QR credentials)
    match /p2p_agents/{agentId} {
      allow read: if true;
      allow write: if isAdminOrStaff() || (isOwner(agentId) && isStaffEmail());
    }

    // Unified Requests Collection (Admin Portal: Enforces 3-Min Claim Limit & Single-Agent Lock)
    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdminOrStaff();
      
      allow update: if isAuthenticated() && (
        isAdminOrStaff() ||
        // 1. Agent accepting their assignment WITHIN 3 minutes
        (
          resource.data.status == 'ASSIGNED' && 
          (resource.data.assignedTo == request.auth.uid || resource.data.assignedAgentId == request.auth.uid) &&
          (resource.data.claimDeadline == null || request.time < resource.data.claimDeadline)
        ) ||
        // 2. Any agent taking a request whose claimDeadline HAS PASSED
        (
          resource.data.status == 'ASSIGNED' && 
          resource.data.claimDeadline != null &&
          request.time > resource.data.claimDeadline
        ) ||
        // 3. Claiming an unassigned pending request
        (
          (resource.data.status == 'PENDING' || resource.data.status == 'OPEN') && 
          (resource.data.assignedTo == null || resource.data.assignedAgentId == null)
        ) ||
        // 4. Updating an active IN_PROGRESS request owned by self
        (
          (resource.data.status == 'IN_PROGRESS' || resource.data.status == 'In Progress') && 
          (resource.data.assignedTo == request.auth.uid || resource.data.assignedAgentId == request.auth.uid)
        )
      );
    }

    // Email & Mail Logging Collections
    match /mail/{mailId} {
      allow read, write: if isAuthenticated();
    }
    match /emails/{mailId} {
      allow read, write: if isAuthenticated();
    }

    // Audit Logs Collections
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow create, update: if isAuthenticated();
      allow delete: if isAdminOrStaff();
    }

    match /auditLogs/{logId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow create, update: if isAuthenticated();
      allow delete: if isAdminOrStaff();
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    match /system_logs/{logId} {
      allow read, write: if isAdminOrStaff();
    }

    // System Config Collection (Treasury keys and backend config - Admin only!)
    match /system_config/{docId} {
      allow read, write: if isAdminOrStaff();
    }
    match /system_config/{docId}/{subPath=**} {
      allow read, write: if isAdminOrStaff();
    }

    // Config Collection (App-level public read-only config)
    match /config/app_config {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Platform Fees Collection (Admin managed)
    match /platform_fees/{feeId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrStaff();
    }

    // Platform Config Collection (Job SLAs, Platform Settings - Admin managed)
    match /platform_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrStaff();
    }
    match /platform_config/{docId}/{subPath=**} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrStaff();
    }

    // Promos Collection
    match /promos/{promoId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdminOrStaff();
      allow update: if isAdminOrStaff() || 
        (isActiveUser() && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'usedBy']));
    }

    // Promo Audit Trail Collection
    match /promo_audit_trail/{auditId} {
      allow read, write: if isAdminOrStaff();
    }

    // News & Promotions Collections
    match /news_posts/{postId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdminOrStaff();
    }

    // KYC Submissions Collection
    match /kyc_submissions/{submissionId} {
      allow read: if isAuthenticated() && (request.auth.uid == submissionId || resource.data.uid == request.auth.uid || isAdminOrStaff());
      allow write: if (isActiveUser() && (request.auth.uid == submissionId)) || isAdminOrStaff();
    }

    // Agent & Staff Realtime Presence Collection
    match /presence/{agentId} {
      allow read: if true;
      allow write: if isAuthenticated() && (isOwner(agentId) || isAdminOrStaff());
    }

// >>> SOURCE: firestore_rules/99_footer.rules
    // ------------------------------------------------------------------------
    // COLLECTION GROUP QUERIES & ROOT CLOSING
    // ------------------------------------------------------------------------

    match /{path=**}/applications/{applicantId} {
      allow read: if isActiveUser() || isAdminOrStaff();
    }

    match /{path=**}/questions/{questionId} {
      allow read: if true;
      allow write: if isActiveUser();
    }

    match /{path=**}/qna/{qnaId} {
      allow read: if true;
      allow write: if isActiveUser() || isAdminOrStaff();
    }
  }
}

